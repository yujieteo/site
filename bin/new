#!/usr/bin/env bash
set -u
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
target=${1:-}
lang=${2:-}

usage() {
  echo "usage: bin/new TARGET go|typescript|python|rust" >&2
  exit 2
}

short_of() {
  case "$1" in
    go) echo go ;;
    typescript) echo ts ;;
    python) echo py ;;
    rust) echo rs ;;
    *) usage ;;
  esac
}

copy_starter() {
  mkdir -p "$target"
  git -C "$root" ls-files -co --exclude-standard | grep -v -e '^SPEC.md$' -e '^langs/' -e '^EXPIRY$' | while IFS= read -r f; do
    mkdir -p "$target/$(dirname "$f")"
    cp "$root/$f" "$target/$f"
  done
  cp -R "$root/langs/$lang/." "$target/"
}

main() {
  local short
  [ -n "$target" ] && [ -n "$lang" ] || usage
  short=$(short_of "$lang")
  [ ! -e "$target/rules.conf" ] || { echo "new: $target already has a starter" >&2; exit 1; }
  copy_starter
  sed -i.bak "s/^lang=.*/lang=$short/" "$target/rules.conf" && rm -f "$target/rules.conf.bak"
  "$target/bin/expiry" create > /dev/null
  git -C "$target" init -q 2> /dev/null
  echo "new: started $target for $lang. Expiry: $(cat "$target/EXPIRY"). Run ./gate there."
}

main
