  cal-20261002-001,s3,"data/notes.md, 2026-09-22 entry (focus is sacrifice)","https://github.com/yujieteo/site/blob/9af2dfda74158151920536fba9f6ae7e0286b836/data/notes.md#L370",2026-09-22,"2026-10-02T03:20:00Z"
  cal-20261002-008,s1,"yujieteo/site PR: mark the open todos and questions in the notes resolved","https://github.com/yujieteo/site/pull/122","2026-10-02T03:16:55Z","2026-10-02T03:20:00Z"
  cal-20261002-008,s2,"data/notes.md, 2026-09-26 entry (exploration debt)","https://github.com/yujieteo/site/blob/9af2dfda74158151920536fba9f6ae7e0286b836/data/notes.md#L230",2026-09-26,"2026-10-02T03:20:00Z"
  cal-20261002-008,s3,"data/notes.md, 2026-09-29 entry (resolved Schwartz todo)","https://github.com/yujieteo/site/blob/9af2dfda74158151920536fba9f6ae7e0286b836/data/notes.md#L52",2026-09-29,"2026-10-02T03:20:00Z"
  cal-20261002-011,s1,FPL Gameweek 6 Wildcard best team + pros/cons of using,"https://www.fantasyfootballscout.co.uk/2026/09/24/fpl-gameweek-6-wildcard-best-team-pros-cons-of-using",2026-09-24,"2026-10-02T03:30:00Z"
  cal-20261002-011,s2,"FPL GW6 Guide: Wildcard, Transfers & International Break","https://onefpl.com/blog/fpl-gameweek-6-guide-2026-27",2026-09-21,"2026-10-02T03:30:00Z"
  cal-20261002-011,s3,"data/notes.md, 2026-09-28 entry (squad rules and chips)","https://github.com/yujieteo/site/blob/9af2dfda74158151920536fba9f6ae7e0286b836/data/notes.md#L84",2026-09-28,"2026-10-02T03:20:00Z"
  cal-20261002-011,s4,"data/notes.md, 2026-09-28 entry (fixture difficulty)","https://github.com/yujieteo/site/blob/9af2dfda74158151920536fba9f6ae7e0286b836/data/notes.md#L80",2026-09-28,"2026-10-02T03:20:00Z"
  cal-20261002-002,s1,yujieteo public repositories,"https://github.com/yujieteo?tab=repositories",null,"2026-10-02T03:20:00Z"
  cal-20261002-002,s2,yujieteo/visuals commit history,"https://github.com/yujieteo/visuals/commits/main",null,"2026-10-02T03:20:00Z"
  cal-20261002-002,s3,yujieteo/site commit history,"https://github.com/yujieteo/site/commits/main",null,"2026-10-02T03:20:00Z"
  cal-20261002-023,s1,Regulation Set M-C is now the official VGC format until 2 December!,"https://victoryroad.pro/2026/09/09/regulation-set-m-c-is-now-the-official-vgc-format-until-2-december/",2026-09-09,"2026-10-02T03:30:00Z"
  cal-20261002-023,s2,"data/notes.md, 2026-09-29 entry (best-of-three information)","https://github.com/yujieteo/site/blob/9af2dfda74158151920536fba9f6ae7e0286b836/data/notes.md#L44",2026-09-29,"2026-10-02T03:20:00Z"
