  cal-20261002-030,s2,"data/notes.md, 2026-09-26 entry (becoming a better human)","https://github.com/yujieteo/site/blob/9af2dfda74158151920536fba9f6ae7e0286b836/data/notes.md#L142",2026-09-26,"2026-10-02T03:20:00Z"
  cal-20261002-030,s3,"data/notes.md, 2026-09-26 entry (brain-off use)","https://github.com/yujieteo/site/blob/9af2dfda74158151920536fba9f6ae7e0286b836/data/notes.md#L158",2026-09-26,"2026-10-02T03:20:00Z"
