{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/dist/**)",
      "Write(/dist/**)",
      "Bash(scripts/deploy.sh:*)",
      "Bash(./scripts/deploy.sh:*)",
      "Bash(bash scripts/deploy.sh:*)",
      "Bash(bash ./scripts/deploy.sh:*)",
      "Bash(sh scripts/deploy.sh:*)",
      "Bash(sh ./scripts/deploy.sh:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(bun src/build.ts)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-commands.py",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-dist.py",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
