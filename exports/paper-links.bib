  key          = {Kenneth R},
  url          = {https://www.fields.utoronto.ca/talk-media/1/42/07/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/42/07/slides.pdf}},
  keywords     = {math.FA, math.CA, math.OA, math.PR, mathematics, functional-analysis, operator-algebras, harmonic-analysis, random-matrix-theory},
  abstract     = {Kenneth R. Davidson, free semigroup algebras admit a Lebesgue--von Neumann--Wold decomposition and are uniformly hyperreflexive. Key computation: on Fock space $\mathcal F_n^2=\ell^2(\mathbb F_n^+)$ the left shifts satisfy $L_i^*L_j=\delta_{ij}I$ and $\sum_iL_iL_i^*=I-\xi_\varnothing\xi_\varnothing^*$, while $\mathcal L_n'=\mathcal R_n$ and every $A\in\mathcal L_n$ has Ces\`aro-summed Fourier expansion $A\sim\sum_wa_wL_w$; the structure projection $P$ determined by $\bigcap_{k\ge1}\mathcal S_0^k=\mathcal WP$ splits an arbitrary free semigroup algebra into von Neumann and type-$L$ corners, and Kennedy's wandering-vector theorem for absolutely continuous representations yields $\mathcal S\simeq\mathcal L^{(\alpha)}\oplus\mathcal S_a\oplus\mathcal S_{vN}\oplus\mathcal S_d$, with every free semigroup algebra hyperreflexive with constant at most $6$.}
}

@misc{michaelbrannan,
  title        = {{Michael Brannan}},
  key          = {Michael Brannan},
  url          = {https://www.fields.utoronto.ca/talk-media/1/36/99/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/36/99/slides.pdf}},
  keywords     = {math.AT, math.CO, mathematics, chromatic-homotopy-theory, graph-theory},
  abstract     = {Michael Brannan, complete quantum graphs have no finite classical coloring but have quantum chromatic number exactly $n^2$, and their coloring algebras possess strongly solid noninjective factor representations. Key computation: the algebra $\mathcal A(\operatorname{Hom}(QK_n,K_{n^2}))$ is generated by $p_{ij}^{(a)}$ with $p_{ij}^{(a)}p_{kl}^{(a)}=\delta_{jk}n^{-1}p_{il}^{(a)}$, $\sum_jp_{ij}^{(a)}p_{jk}^{(b)}=\delta_{ab}p_{ik}^{(a)}$, $\sum_ip_{ii}^{(a)}=n^{-1}1$, and $\sum_ap_{ij}^{(a)}=\delta_{ij}1$; any unitary error basis $\{u_a\}_{a=1}^{n^2}\subset U(M_n)$ gives the representation $p_{ij}^{(a)}\mapsto n^{-1}u_a^*e_{ij}u_a$, while the quantum Hoffman bound supplies the reverse inequality, proving $\chi_q(QK_n)=n^2$ whereas $\chi_{\mathrm{loc}}(QK_n)=\infty$; for $n\ge3$ the same universal algebra has a faithful trace whose GNS algebra is a strongly solid noninjective $\mathrm{II}_1$ factor.}
}

@misc{raule,
