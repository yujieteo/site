  abstract     = {Ivan Limonchenko (joint with Rade \v{Z}ivaljevi\'c and Matvey Sergeev), flag Bier spheres are classified by four families of simple polytopes, and every Bier sphere canonically determines smooth moment-angle and toric manifolds. Key computation: every flag $\operatorname{Bier}(K)$ is the nerve of $I^n$, $I^n\times Q_5$, $I^n\times Q_6$, or $I^n\times P_4$; moreover $s_{\mathbb R}(\operatorname{Bier}(K))=s(\operatorname{Bier}(K))=m+1$, and the cones $C(\sigma,\tau)=\mathbb R_{\ge0}\langle-e_p,e_q\mid p\in\sigma,\ q'\in\tau\rangle$ form a complete regular fan $\Sigma(K)\subset\mathbb R^{m-1}$, producing the smooth manifolds $Z_{\operatorname{Bier}(K)}^{3m-1}$ and $X_{\Sigma(K)}^{2(m-1)}$.}
}

@misc{daisukekishimotojoint,
