  key          = {Paul Skoufranis},
  url          = {https://www.fields.utoronto.ca/talk-media/1/73/36/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/73/36/slides.pdf}},
  keywords     = {math.OA, math.PR, math.RA, math.NA, mathematics, linear-algebra, operator-algebras, probability},
  abstract     = {Paul Skoufranis, tracial inequalities completely characterize convex hulls of unitary orbits of self-adjoint elements in arbitrary unital $C^*$-algebras and extend to joint majorization of commuting tuples. Key computation: for self-adjoint $S,T\in A$, one has $S\in\overline{\operatorname{conv}}(\mathcal U(T))$ exactly when $\tau((S-\alpha)_+)\le\tau((T-\alpha)_+)$ and $\tau((-S-\alpha)_+)\le\tau((-T-\alpha)_+)$ for every lower-semicontinuous trace $\tau$ and $\alpha\in\mathbb R$; in $M_n$, this is equivalent to $\sum_{k=1}^ma_k\le\sum_{k=1}^mb_k$ for ordered eigenvalues (equality at $m=n$), to $a=Xb$ for a doubly stochastic $X$, and to a unital trace-preserving completely positive map $\Psi$ with $\Psi(T)=S$.}
}

@misc{danursujoint,
