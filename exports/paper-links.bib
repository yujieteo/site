  keywords     = {math.RT, math.AP, math.AG, mathematics, geometric-representation-theory, pde, representation-theory, talk},
  abstract     = {Marie-France Vign\'eras (joint with Guy Henniart), an admissible representation of $\operatorname{GL}_n(D)$ is, near the identity, an integral combination of parabolically induced trivial representations, making the growth of Moy--Prasad invariants polynomial and identifying its Gelfand--Kirillov dimension. Key computation: for $\operatorname{char}C\ne p$, $\pi\sim\sum_{\lambda\vdash n}c_\lambda(\pi)\operatorname{ind}_{P_\lambda}^{G}\mathbf1$ on a sufficiently small open subgroup; nilpotent orbits correspond to partitions with $\dim_F\mathcal O_\lambda=2d^2\sum_{i<j}\lambda_i\lambda_j$, and hence $\dim_CV^{G_{x,r+i/d}}=Q_{\pi,x,r}(p^i)$ where $Q_{\pi,x,r}(X)=\sum_{\lambda\vdash n}c_\lambda(\pi)|P_\lambda\backslash G/G_{x,r}|X^{fd\,d(\lambda)}$, yielding $\dim_{\mathrm{GK}}\pi=fd\max\{d(\lambda):c_\lambda(\pi)\ne0\}$.}
}

@misc{zhizhangxiejoint,
