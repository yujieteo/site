  keywords     = {math.FA, math.RA, math.NA, mathematics, functional-analysis, linear-algebra, talk},
  abstract     = {Dragan Vukoti\'c (joint work with Alexandru Aleman and Aristomenis Siskakis), the conformal-invariance index of an analytic Banach space determines the complete spectrum of its Hilbert matrix operator. Key computation: the weighted automorphisms $W_a^{1/2}f=(\varphi_a')^{1/2}(f\circ\varphi_a)$ have generator $Df(z)=(1-z^2)f'(z)-zf(z)$ with $\sigma(D)=S_\alpha=\{\lambda:|\operatorname{Re}\lambda|\le|1-2\alpha|\}$, and $Kf(z)=\int_{-1}^1f(r)/(1-rz)\,dr=\int_{-1}^1W_a^{1/2}f(z)\,da/\sqrt{1-a^2}$; spectral mapping gives $\sigma(H)=\sigma(K)=\{0\}\cup\{\pi/\cos(\pi\lambda/2):\lambda\in S_\alpha\}$ and $r(H)=\pi/\cos(\pi|\alpha-1/2|)$, recovering $\sigma(H)=[0,\pi]$ when $\alpha=1/2$.}
}

@misc{francescofournierfacio,
  title        = {{Francesco Fournier-Facio (joint with Bharatram Rangarajan)}},
  key          = {Francesco Fournier-Facio (joint with Bharatram Rangarajan)},
  url          = {https://www.fields.utoronto.ca/talk-media/1/57/71/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/57/71/slides.pdf}},
  keywords     = {math.DS, math.CT, math.CA, math.RA, mathematics, ergodic-theory, homological-algebra, ode-and-dynamical-systems, talk},
  abstract     = {Francesco Fournier-Facio (joint with Bharatram Rangarajan), every lamplighter $\Gamma\wr\mathbb Z$ is Ulam stable with a linear estimate, which implies the same for Thompson's groups $F',F,T$ and embeds every countable group in a three-generated linearly Ulam-stable group. Key computation: an asymptotic homomorphism $\varphi_n:\Gamma\to U(k_n)$ defines $W=\prod_{n\to\omega}\mathfrak u(k_n)$ and an Ulam class $\alpha_\varphi\in H_a^2(\Gamma,W)$, with $\alpha_\varphi=0$ equivalent to a defect-diminishing correction $\operatorname{dist}(\varphi_n,\psi_n)=O_\omega(\operatorname{def}(\varphi_n))$ and $\operatorname{def}(\psi_n)=o_\omega(\operatorname{def}(\varphi_n))$; the highly ergodic Zimmer-amenable model for $\Gamma\wr\mathbb Z$ makes the relevant invariant cochain complex alternate $\operatorname{id}$ and $0$, killing every Ulam class, while the coamenable inclusion $F[a,b]\cong F< F'$ injects restriction on $H_a^2$ and transfers the vanishing to $F',F,T$.}
}

@misc{stephens,
  title        = {{Stephen S}},
  key          = {Stephen S},
  url          = {https://www.fields.utoronto.ca/talk-media/1/26/61/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/26/61/slides.pdf}},
  keywords     = {math.NT, math.AG, math.CA, math.CO, mathematics, algebraic-geometry, graph-theory, harmonic-analysis, modular-forms},
  abstract     = {Stephen S. Kudla, the numerical ring of special cycles on an orthogonal Shimura variety is determined by Fourier coefficients of pullbacks of Hilbert--Siegel Eisenstein series and depends only on the finite quadratic space. Key computation: the theta-form identity $[\theta(g_\tau';\varphi)]=\phi_n(\tau;\varphi)=\sum_{T\ge0}Z(T,\varphi)q^T$ and wedge compatibility $\varphi_\infty^{(n_1+n_2)}=\varphi_\infty^{(n_1)}\wedge\varphi_\infty^{(n_2)}$, followed by Siegel--Weil, give $\langle z(T_1,\varphi_1),z(T_2,\varphi_2)\rangle=A(T_1,T_2;\lambda_{V_f}(\varphi_1\otimes\varphi_2))$ for $n_1+n_2=m$ and $\langle z(T_1,\varphi_1)z(T_2,\varphi_2),z(T_3,\varphi_3)\rangle=A(T_1,T_2,T_3;\lambda_{V_f}(\varphi_1\otimes\varphi_2\otimes\varphi_3))$ for $n_1+n_2+n_3=m$; nondegeneracy determines multiplication, and matching Schwartz functions for $V(\mathbb A_f)\simeq V'(\mathbb A_f)$ yield an isometric graded-ring isomorphism $SC^\bullet(V)\simeq SC^\bullet(V')$.}
}

@misc{iskander,
  title        = {{Iskander A}},
  key          = {Iskander A},
  url          = {https://www.fields.utoronto.ca/talk-media/1/23/12/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/23/12/slides.pdf}},
  keywords     = {math.AT, math.RT, math.RA, mathematics, algebraic-topology, lie-theory},
  abstract     = {Iskander A. Taimanov, the generalized Kummer resolution gives an explicit intersection-ring classification for a simply connected Joyce $G_2$-manifold and shows that it has no nontrivial Massey products. Key computation: for the commuting involutions $\alpha,\beta,\gamma$ on $T^7$ with $\Gamma\cong(\mathbb Z/2)^3$, one computes $b_1(T^7/\Gamma)=b_2(T^7/\Gamma)=0$ and $b_3(T^7/\Gamma)=b_4(T^7/\Gamma)=7$; resolving the twelve singular $T^3\times(D/\{\pm1\})$ strata adds classes giving $b_2(M)=12$ and $b_3(M)=43$, and the nonzero products in the homology intersection ring are $c_{\delta i}\cap c'_{\delta i}=-2$, $c_{\delta ij}\cap c'_{\delta ij}=-2$, $t_\delta\cap t'_\delta=4$, $t_i\cap t'_i=8$, $c'_{\delta i}\cap c'_{\delta i}=-2t_\delta$, and $t'_\delta\cap c'_{\delta i}=4c_{\delta i}$, which by Poincar\'e duality determines $H^*(M;\mathbb Q)$.}
}

@misc{herbertgangl,
  title        = {{Herbert Gangl}},
  key          = {Herbert Gangl},
  url          = {https://www.fields.utoronto.ca/talk-media/1/41/26/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/41/26/slides.pdf}},
  keywords     = {math.AG, math.NT, math.CA, mathematics, motives, l-functions, special-functions},
  abstract     = {Herbert Gangl, explicit polylogarithmic functional equations realize Zagier's polylogarithm conjecture through weight four and construct higher-weight analogues of the decisive motivic relation. Key computation: Bloch's map $\delta_2^F:\mathbb Z[F]\to\bigwedge^2F^\times$, $[x]\mapsto x\wedge(1-x)$, together with the exact sequence $0\to T(F)\to K_3(F)/K_3^M(F)\to B_2(F)\to0$, turns the single-valued dilogarithm into the regulator formula $\pi^{r_2}\zeta_F^*(-1)=q\det(\mathcal L_2(\xi_i^\sigma))_{i,\sigma}$; at weight four an explicit 122-term reduction $I_{3,1}(z,V(x,y))\equiv\sum_{i=1}^{122}c_i\operatorname{Li}_4(f_i(x,y,z))$ modulo lower-weight products supplies the $Q_4$ relation used by Goncharov--Rudenko to prove the conjecture for $m=4$, while the explicit quadruple ratio is a 368-orbit combination on eight points in $\mathbb P^3$ representing a nonzero class in $H^7(GL_4(\mathbb C),\mathbb R)$.}
}

@misc{jongbaeksongjoint,
  title        = {{Jongbaek Song (joint with Xin Fu and Tseleung So)}},
  key          = {Jongbaek Song (joint with Xin Fu and Tseleung So)},
  url          = {https://www.fields.utoronto.ca/talk-media/2/51/02/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/2/51/02/slides.pdf}},
  keywords     = {math.AT, math.RA, math.NA, mathematics, algebraic-topology, linear-algebra, talk},
  abstract     = {Jongbaek Song (joint with Xin Fu and Tseleung So), the fan vectors of a compact toric surface determine its integral cohomology ring through an explicit cup-product matrix. Key computation: for rays $(-1,0),(0,-1),(a_1,b_1),\ldots,(a_n,b_n)$, a cellular cofibration $S^3\to\bigvee_{i=1}^nS_i^2\to X_\Sigma$ yields bases $H^2(X_\Sigma;\mathbb Z)=\mathbb Z\langle u_1,\ldots,u_n\rangle$ and $H^4(X_\Sigma;\mathbb Z)=\mathbb Z\langle v\rangle$; the weighted Stanley--Reisner model and the morphisms $X_\Sigma\to\mathbb{CP}_{1,a_i,b_i}^2$ send $[a_ib_ix_1]$ to $\sum_{k<i}a_kb_i y_k+a_ib_i y_i+\sum_{k>i}a_ib_k y_k$ and $[x_2x_3]$ to $[y_{n+1}y_{n+2}]$, so $u_i\smile u_j=a_{\min(i,j)}b_{\max(i,j)}v$ and $M(X_\Sigma)_{ij}=a_{\min(i,j)}b_{\max(i,j)}$.}
}

@misc{lisajeffreyjoint,
  title        = {{Lisa Jeffrey (joint with Nan-Kuo Ho}},
  key          = {Lisa Jeffrey (joint with Nan-Kuo Ho},
  url          = {https://www.fields.utoronto.ca/talk-media/1/26/31/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/26/31/slides.pdf}},
  keywords     = {math.AG, mathematics, algebraic-geometry, singularities, talk},
  abstract     = {Lisa Jeffrey (joint with Nan-Kuo Ho, Paul Selick, and Eugene Xia), Mayer--Vietoris decompositions compute the integral cohomology ring of the genus-two $SU(2)$ character variety with puncture monodromy $-I$ and identify its connected-sum type. Key computation: with $M=\mu^{-1}(-I)$ and $A=M/SU(2)$, the commutator trace stratification gives $A\simeq T\cup_{\mathbb{RP}^3\times S^2}T$, where $T=\{(g,h):[g,h]=I\}\simeq S^3\vee S^3\vee S^2\vee\Sigma^2\mathbb{RP}^2$; the prequantum bundle Mayer--Vietoris sequence $0\to\mathbb Z/2\to H^4(L;\mathbb Z)\to\mathbb Z/2\to0$ and $H^4(L;\mathbb Z/2)=\mathbb Z/2$ force $H^4(L;\mathbb Z)=\mathbb Z/4$, and yield $H^*(A)=\langle1,x,s_1,s_2,s_3,s_4,y,z\rangle$ with $|x|=2$, $|s_i|=3$, $|y|=4$, $|z|=6$, $x^2=4y$, and $xy=s_1s_3=s_2s_4=z$; Wall's theorem then gives $A\cong A^0\#(S^3\times S^3)\#(S^3\times S^3)$.}
}

@misc{rondonagi,
  title        = {{Ron Donagi}},
  key          = {Ron Donagi},
  url          = {https://www.fields.utoronto.ca/talk-media/2/42/29/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/2/42/29/slides.pdf}},
  keywords     = {math.AG, mathematics, moduli-spaces},
  abstract     = {Ron Donagi, supermoduli is non-split and non-projected in genus at least five, while the super Mumford isomorphism constructs natural measures that extend across the vanishing-theta-null locus and, with Ramond punctures, across codimension at least two. Key computation: a supermanifold $S=(M,\mathcal O_S)$ has splitting obstruction $\omega\in H^1(M,T_M\otimes\bigwedge^2V^*)$, appearing as the third component of its super Atiyah class alongside the Atiyah classes of $T_+S$ and $T_-S$; for $\mathfrak M_g$, $\dim\mathfrak M_g=(3g-3\mid2g-2)$ with $T_+|_{[S]}=H^1(T_M)$ and $T_-|_{[S]}=H^1(T_M^{1/2})$, and restricting $\omega$ to a lifted family of odd-branched covers gives $\omega\ne0$ for $g\ge5$; the identity $\mathcal L_{3/2}\simeq\mathcal L_{1/2}^{5}$ defines the superstring measure, and a codimension-$\ge2$ Hartogs extension gives a natural measure on $\mathfrak M_{g,0,r}$ for $r\ge2$ Ramond punctures.}
}

@misc{mengfailim,
  title        = {{Meng Fai Lim}},
  key          = {Meng Fai Lim},
  url          = {https://www.fields.utoronto.ca/talk-media/1/33/73/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/33/73/slides.pdf}},
  keywords     = {math.NT, math.AG, math.AT, mathematics, arithmetic-statistics, etale-cohomology, iwasawa-theory, topological-hochschild-homology},
  abstract     = {Meng Fai Lim, the growth of \'etale wild kernels in multi-false-Tate towers is controlled by an Iwasawa-module rank, and its smaller-order growth is equivalent to the noncommutative Greenberg conjecture. Key computation: Poitou--Tate duality identifies $R_i(F)=WK_{2i}^{\mathrm{\acute et}}(F)^\vee$ with the kernel of $H^1(G_S(F),\mathbb Q_p/\mathbb Z_p(-i))\to\bigoplus_{v\in S}H^1(F_v,\mathbb Q_p/\mathbb Z_p(-i))$; Hochschild--Serre gives $\ker h_n=H^1(G_n,\mathbb Q_p/\mathbb Z_p(-i)(F_\infty))$ and $\operatorname{coker}h_n\subseteq H^2(G_n,\mathbb Q_p/\mathbb Z_p(-i)(F_\infty))$, yielding $e(R_i(F_\infty)^{G_n})-e(R_i(F_n))=O(np^{(d-2)n})$; if the cyclotomic $\mu$-conjecture holds, then $e(WK_{2i}^{\mathrm{\acute et}}(F_n))=\operatorname{rank}_{\mathbb Z_p[[H]]}Y_i(F_\infty)\,np^{(d-1)n}+O(p^{(d-1)n})$, and vanishing of this rank is equivalent to $\operatorname{Gal}(K(F_\infty)/F_\infty)$ being pseudo-null.}
}

@misc{soumensarkar,
  title        = {{Soumen Sarkar}},
  key          = {Soumen Sarkar},
  url          = {https://www.fields.utoronto.ca/talk-media/2/50/96/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/2/50/96/slides.pdf}},
  keywords     = {math.AT, math.CO, mathematics, equivariant-topology, graph-theory},
  abstract     = {Soumen Sarkar, weighted Grassmann orbifolds have torsion-free integral cohomology concentrated in even degrees, and their integral equivariant cohomology is completely encoded by an orbifold GKM graph. Key computation: for $W=(w_1,\ldots,w_n)$ and $a\ge1$, $WGr(d,n)=M_d(n,d;\mathbb C)/{\sim_W}$ with $(a_1,\ldots,a_n)^t\sim_W(t^{w_1}a_1,\ldots,t^{w_n}a_n)^tT$ whenever $t^a=\det T$; its finite-quotient strata satisfy that $H_j(U(L)/G;\mathbb Z)$ has no $p$-torsion for $p\nmid|G|$, producing a torsion-free even-dimensional cellular filtration; each $WGr(d,n)$ is consequently a GKM orbifold and $H_{T^n}^*(WGr(d,n);\mathbb Z)\cong\{f:V(\Gamma)\to H^*(BT^n;\mathbb Z)\mid r_e\alpha(e)\text{ divides }f(s(e))-f(t(e))\}=H_{T^n}^*(\Gamma,\alpha,\theta)$.}
}

@misc{paymaneskandarijoint,
  title        = {{Payman Eskandari (joint with Kumar Murty)}},
  key          = {Payman Eskandari (joint with Kumar Murty)},
  url          = {https://www.fields.utoronto.ca/talk-media/1/27/43/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/27/43/slides.pdf}},
  keywords     = {math.AT, math.CO, math.CT, math.LO, mathematics, fixed-point-theorems, graph-theory, homological-algebra, mathematical-logic, talk},
  abstract     = {Payman Eskandari (joint with Kumar Murty), the Ceresa cycle of every Fermat curve $F(p)$ of prime degree $p>7$ has infinite order modulo rational equivalence, for every base point. Key computation: quadratic iterated integrals give $E_e^\infty\in\operatorname{Ext}((H^1)^{\otimes3},\mathbb Q(-1))$, and for a correspondence $Z$ the Darmon--Rotger--Sols formula is $\xi_Z^{-1}(E_e^\infty)=(\int_\Delta\xi_Z)(\infty-e)-P_Z$; taking $Z$ as the graph of $(x,y,z)\mapsto(-y,z,x)$ on $F(p)$ gives fixed points $Q=(\eta,\eta^{-1},1)$ and $\bar Q=(\eta^{-1},\eta,1)$ and hence $P_Z=Q+\bar Q-2e$, which Gross--Rohrlich proves has infinite order while $\infty-e$ is torsion; thus $E_e^\infty\ne0$, its $H^1\otimes\xi_\Delta$ component $-2g\infty+2e+K$ is torsion, and Harris--Pulte identifies the remaining component with $\tfrac12AJ(F(p)_e-F(p)_e^-)$, forcing the Abel--Jacobi image, and therefore the Ceresa cycle, to be nonzero.}
}

@misc{avizeffb,
