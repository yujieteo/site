  keywords     = {math.CT, math.RA, math.GR, math.LO, mathematics, abstract-algebra, category-theory, topos-theory},
  abstract     = {Brais Ramos P\'erez, modules over invertible Hopf-algebra $1$-cocycles are equivalent to modules over the associated Hopf braces. Key computation: an invertible $1$-cocycle is a coalgebra isomorphism $\pi:A\to H$ satisfying $\pi\circ\mu_A=\mu_H\circ(\pi\otimes\varphi_H)\circ(\delta_A\otimes\pi)$; it produces the brace $H_\pi=Q(\pi,\varphi_H)$, and the functor $H_\pi:(\pi,\varphi_H)\text{-}\operatorname{Mod}\to H_\pi\text{-}\operatorname{Mod}$ sends $(M,N,\varphi_M,\phi_M,\varphi_N,\gamma)$ to $(M,\phi_M,\gamma\circ\varphi_N\circ(\pi^{-1}\otimes\gamma^{-1}))$, with inverse $M_{(\pi,\operatorname{id}_H)}\circ G_{H_\pi}$, so the composites are $\operatorname{id}_{H_\pi\text{-}\operatorname{Mod}}$ and naturally isomorphic to $\operatorname{id}_{(\pi,\varphi_H)\text{-}\operatorname{Mod}}$.}
}

