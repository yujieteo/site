  abstract     = {Roberto Hern\'andez Palomares (joint with Brent Nelson), irreducible $C^*$-discrete inclusions are precisely reduced crossed products by outer unitary tensor-category actions and therefore admit a categorical standard invariant. Key computation: for a faithful expectation $E:A\subset B$, the canonical correspondence has $\langle b_1\mid b_2\rangle_A=E(b_1^*b_2)$ and the algebraic discrete part decomposes as $B_\diamond\cong\bigoplus_{K\in\operatorname{Irr}(\operatorname{Bim}_{\mathrm{fgp}}(A))}K\otimes\operatorname{Hom}_{A-A}(K,B\Omega)$; the condition $\overline{B_\diamond}^{\|\cdot\|_B}=B$ and $A'\cap B=\mathbb C$ is equivalent to data $F:\mathcal C\curvearrowright A$, $\mathbf B\in C^*\!\operatorname{Alg}(\mathcal C)$ with $A\subset B\cong A\subset A\rtimes_{F,r}\mathbf B$, as illustrated by $\mathcal O_n\cong\operatorname{UHF}_{n^\infty}\rtimes_{F_1,r}\mathbb C[\mathbb Z]$.}
}

@misc{mariefrancevign,
