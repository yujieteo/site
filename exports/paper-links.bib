  keywords     = {math.OA, mathematics, operator-algebras},
  abstract     = {P. Muthukumar, a Schur-class divisibility condition classifies exactly which Beurling subspaces are invariant under a composition operator. Key computation: for inner $\theta$ and analytic $\varphi:\mathbb D\to\mathbb D$, the conditions $C_\varphi(\theta H^2)\subseteq\theta H^2$ and $(\theta\circ\varphi)/\theta\in\mathcal S(\mathbb D)$ are equivalent; Douglas range inclusion rewrites this as $C_\varphi M_\theta=M_\theta X$, and evaluation of $X^*M_\theta^*=M_\theta^*C_\varphi^*$ on $K_w(z)=(1-\overline wz)^{-1}$ yields $X^*(\overline{\theta(w)}K_w)=\overline{\theta(\varphi(w))}K_{\varphi(w)}$, giving an equivalent bounded-kernel criterion and, for Blaschke $B$, the zero-multiplicity test $\operatorname{mult}_B(w)\le\operatorname{mult}_{B\circ\varphi}(w)$.}
}

@misc{draganvukotic,
  title        = {{Dragan Vukoti\'c (joint work with Alexandru Aleman and Aristomenis Siskakis)}},
  key          = {Dragan Vukoti\'c (joint work with Alexandru Aleman and Aristomenis Siskakis)},
