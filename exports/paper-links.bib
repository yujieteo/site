  abstract     = {Samarpita Ray (joint with Abhishek Banerjee and Mamta Balodi), representations of coalgebras have Grothendieck categories of cis- and trans-comodules, with cartesian subcategories serving as coalgebraic analogues of quasi-coherent sheaves. Key computation: for $C:X\to\operatorname{Coalg}$ with right-semiperfect values, a map $V\to M_x$ from a finite-dimensional projective generates $N_y=\operatorname{Im}(\bigoplus_{\beta:x\to y}\beta_*V\to M_y)$ with $|N|\le\kappa=\sup\{\aleph_0,|\operatorname{Mor}X|,|K|\}$, and every $M$ is a sum of such $N$, proving $\operatorname{Com}^{\mathrm{cs}}\!\text{-}C$ is Grothendieck; if $C$ is quasi-finite then $\alpha_!=H_{C_y}(C_x,-)\dashv\alpha^*$ gives the corresponding Grothendieck classification for $\operatorname{Com}^{\mathrm{tr}}\!\text{-}C$, while semiperfect $C$ makes $\operatorname{Com}^{\mathrm{cs}}\!\text{-}C$ a hereditary torsion class in $C^*\text{-}\operatorname{Mod}^{\mathrm{tr}}$.}
}

@misc{braisramosp,
