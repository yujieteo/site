  key          = {Guozhen Wang},
  url          = {https://math.mit.edu/topology/notes/wang-slides.pdf},
  howpublished = {\url{https://math.mit.edu/topology/notes/wang-slides.pdf}},
  keywords     = {math.CT, math.AG, math.AT, math.NT, mathematics, homological-algebra, descent-theory, topological-hochschild-homology, abelian-varieties},
  abstract     = {Guozhen Wang, topological cyclic homology of local fields via a descent spectral sequence built from a prismatic/Dieudonné-type $\delta$-ring structure. Key computation: for a local field $K$ with ring of integers $O_K$ and uniformizer $\varpi$, computes relative $THH(O_K/S\langle z\rangle)$ for $S\langle z\rangle=\mathbb{Z}_p[z]$, $z\mapsto\varpi$; the filtration by the fiber of $\mathrm{can}-\varphi$ gives $E_1^{i,j}\Rightarrow TC_{i+j}(O_K)$, and the $E_2$-term of the descent spectral sequence for $TP(O_K)$ is computed as $\mathrm{Ext}$ of the Hopf algebroid $(TP_0(O_K/S[z_0,z_1]), TP_0(O_K/S[z_0,z_0,z_1]))$, with $TP_0(O_K/S[z_0,z_1])$ the Nygaard-completion of a $\delta$-ring generated by $h=\varphi(E)^{-1}\sigma$-type elements.}
}

@misc{albertjinghuiyang,
