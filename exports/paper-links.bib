  abstract     = {Zhang, a Quillen–Lichtenbaum conjecture for Dirichlet $L$-functions. Key computation: reformulates Dirichlet's unit theorem $\mathcal{O}_F^\times\cong\mu(F)\times\mathbb{Z}^{\oplus r_1+r_2-1}$ (so $\dim_\mathbb{Q}\mathcal{O}_F^\times\otimes\mathbb{Q}=\mathrm{ord}_{s=0}\zeta_F(s)$) and the class number formula $\zeta_F^*(0)=-\frac{|cl(F)|}{|\mu(F)|}R(F)$ via $K_0(\mathcal{O}_F)\cong\mathbb{Z}\oplus cl(F)$ and $K_1(\mathcal{O}_F)\cong\mathcal{O}_F^\times$, then states/proves a Quillen–Lichtenbaum-type statement identifying rational equivariant algebraic K-groups of number fields with values of Dirichlet $L$-functions at nonpositive integers.}
}

