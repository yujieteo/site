  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/57/18/slides.pdf}},
  keywords     = {math.PR, math.OA, mathematics, free-probability, probability},
  abstract     = {Jamie Mingo, noncrossing-partition cumulants characterize free independence and convert the moment sequence of a noncommutative random variable into Voiculescu's compositional-transform equation. Key computation: Möbius inversion on $NC(n)$ gives $\kappa_n(a_1,\ldots,a_n)=\sum_{\pi\in NC(n)}\mu_{NC(n)}(\pi,1_n)\varphi_\pi(a_1,\ldots,a_n)$ and $\varphi(a_1\cdots a_n)=\sum_{\pi\in NC(n)}\kappa_\pi(a_1,\ldots,a_n)$; unital subalgebras $A_1,\ldots,A_s$ are freely independent iff every mixed cumulant vanishes, namely $\kappa_n(a_1,\ldots,a_n)=0$ whenever $a_i\in A_{j_i}$ and $\ker(j)\ne1_n$. Decomposing a noncrossing partition by the block containing $1$ yields $m_n=\sum_{s=1}^n\kappa_s\sum_{i_1+\cdots+i_s+s=n}m_{i_1}\cdots m_{i_s}$, hence $C(zM(z))=M(z)$ and $R(z)=G^{\langle-1\rangle}(z)-z^{-1}$.}
}

