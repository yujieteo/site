  title        = {{Herv\'e Queff\'elec (joint with Pascal Lef\`evre}},
  key          = {Herv\'e Queff\'elec (joint with Pascal Lef\`evre},
  url          = {https://www.fields.utoronto.ca/talk-media/1/38/65/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/38/65/slides.pdf}},
  keywords     = {math.CA, math.CV, mathematics, complex-analysis, harmonic-analysis, talk},
  abstract     = {Herv\'e Queff\'elec (joint with Pascal Lef\`evre, Daniel Li, and Luis Rodr\'iguez-Piazza), conditional multipliers of admissible weighted Hardy spaces classify symbols by strict range contraction and finite Blaschke products. Key computation: for $H=H^2(\beta)$ and $M(H,\varphi)=\{w:w(f\circ\varphi)\in H\ \forall f\in H\}$, one has $M(H^2,\varphi)\subseteq M(H,\varphi)$ and the sharp equivalences $M(H,\varphi)=H\Longleftrightarrow\|\varphi\|_\infty<1$ and $M(H,\varphi)=H^\infty\Longleftrightarrow\varphi$ is a finite Blaschke product; for $H^2$, the kernel estimate $\|K_a\|_{\mathrm{op}}\le\sqrt{(1+|\varphi(a)|)/(1-|\varphi(a)|)}(1-|a|^2)^{-1/2}$ turns $M(H^2,\varphi)=H^\infty$ into $\sup_a(1-|\varphi(a)|)/(1-|a|)<\infty$, which is precisely the finite-Blaschke condition.}
}

@misc{p,
  title        = {{P}},
  key          = {P},
  url          = {https://www.fields.utoronto.ca/talk-media/1/45/12/slides.pdf},
