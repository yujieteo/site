  abstract     = {Bill Casselman, the inverse Satake transform gives an explicit basic Schwartz function for every irreducible finite-dimensional representation of $\widehat{\mathrm{GL}}_2$, reducing the construction to symmetric-power multiplicities and vector partition functions. Key computation: for $F_{m,n}=\mathbf1_{K\varpi^{(m,n)}K}$, $\mathcal S^{-1}(\det^nq^{(m-n)/2}\chi_{m-n})=\Phi_{m,n}=\sum_{i:m-i\ge n+i}F_{m-i,n+i}$, while $\det(I-At)^{-1}=\sum_{m\ge0}\operatorname{tr}S^m(A)t^m$ and $S^m(\sigma_k)=\sum_{i\le km/2}\delta_{km}(i)\det^i\sigma_{km-2i}$ imply that the $L$-function's basic function is $\sum_{i\le km/2}q^i\delta_{km}(i)\Phi_{km-i,i}$; writing the weight multiplicity piecewise as $\omega_{km}(n)=\sum_{j=0}^i(-1)^jD_{\alpha_j}(n-m_j)$ on $m_i\le n\le m_{i+1}$ proves it is quasi-polynomial on each Sturmfels cone and yields the displayed Sylvester asymptotics for $\omega_{km}$ and $\delta_{km}$.}
}

@misc{malorsespinosajoint,
  title        = {{Malors Espinosa (joint with Melissa Emory}},
  key          = {Malors Espinosa (joint with Melissa Emory},
  url          = {https://www.fields.utoronto.ca/talk-media/2/65/26/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/2/65/26/slides.pdf}},
  keywords     = {math.NT, math.SG, math.CA, math.RT, mathematics, symplectic-geometry, algebraic-number-theory, automorphic-forms, harmonic-analysis, talk},
  abstract     = {Malors Espinosa (joint with Melissa Emory, Debanjana Kundu, and Tian An Wong), interpolation and Poisson summation isolate the trivial and special-representation traces inside the regular elliptic trace formula for $\mathrm{GL}_2$ over a totally real number field. Key computation: contributing elliptic classes are exactly $(\tau,u)\in\mathcal O_K\times\mathcal O_K^\times$ with $\tau^2-4u\epsilon$ nonsquare, and $(\tau^2-4u\epsilon)=\mathfrak S_\gamma^2\Delta_\gamma$ defines $O(z,\gamma)=N(\mathfrak S_\gamma)^z\sum_{\mathfrak d\mid\mathfrak S_\gamma}N(\mathfrak d)^{1-2z}\prod_{\mathfrak q\mid\mathfrak d'}(1-\chi_\gamma(\mathfrak q)N(\mathfrak q)^{-z})$; then $O(1,\gamma)=\prod_{\mathfrak q}O(\gamma,f_\mathfrak q)$ and $\Lambda(z,\chi_\gamma)O(z,\gamma)=\Lambda(1-z,\chi_\gamma)O(1-z,\gamma)$, while Poisson summation gives $\operatorname{Tr}(1(f))=p^{-k/2}(1-p^{-(k+1)})(1-p^{-1})^{-1}\sum_\pm\int_{\mathbb R^{2n-1}}\theta_\pm(x,y)\,dx\,dy$ and identifies the second residue as $-2$ times the special-representation trace.}
}

@misc{andrewdeanjoint,
  title        = {{Andrew Dean (joint with Luis Santiago)}},
  key          = {Andrew Dean (joint with Luis Santiago)},
  url          = {https://www.fields.utoronto.ca/talk-media/1/37/07/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/37/07/slides.pdf}},
  keywords     = {math.FA, mathematics, functional-analysis, talk},
  abstract     = {Andrew Dean (joint with Luis Santiago), triples of real, complexified, and quaternionified Cuntz semigroups classify unital real AI algebras and their homomorphisms up to approximate unitary equivalence. Key computation: $\operatorname{Inv}(A)$ is the diagram $(\operatorname{Cu}(A),[1])\to(\operatorname{Cu}(A\otimes_{\mathbb R}\mathbb C),[1])\to(\operatorname{Cu}(A\otimes_{\mathbb R}\mathbb H),[1])$; every morphism $\eta=(\eta_r,\eta_c,\eta_h):\operatorname{Inv}(A)\to\operatorname{Inv}(B)$ is realized by a unital $*$-homomorphism $\varphi:A\to B$ with $(\operatorname{Cu}(\varphi),\operatorname{Cu}(\varphi\otimes_{\mathbb R}\operatorname{id}_{\mathbb C}),\operatorname{Cu}(\varphi\otimes_{\mathbb R}\operatorname{id}_{\mathbb H}))=(\eta_r,\eta_c,\eta_h)$, and equality $\operatorname{Inv}(\varphi)=\operatorname{Inv}(\psi)$ implies $\varphi\sim_{\mathrm{a.u.}}\psi$.}
}

@misc{joachimzachariasjoint,
  title        = {{Joachim Zacharias (joint with Joan Bosa}},
  key          = {Joachim Zacharias (joint with Joan Bosa},
  url          = {https://www.fields.utoronto.ca/talk-media/1/73/75/slides.pdf},
