  keywords     = {math.OA, mathematics, operator-algebras, talk},
  abstract     = {Joachim Zacharias (joint with Joan Bosa, Francesc Perera, and Jianchao Wu), almost elementary actions have $\mathcal Z$-stable crossed products and unify almost finite dynamics with $\mathcal Z$-stability of simple nuclear algebras. Key computation: a noncommutative tower is a c.p.c. order-zero map $\lambda:M_n\otimes C(S)\to A$ satisfying $\lambda(\,\cdot\,\otimes\delta_g)=\alpha_{gh^{-1}}\lambda(\,\cdot\,\otimes\delta_h)$; castles approximating finite sets with $1-\lambda(h)\precsim_G b$ and $\|h-g\cdot h\|<\varepsilon$ define almost elementariness, for which $\alpha:G\curvearrowright A\Rightarrow A\rtimes_\alpha G$ is almost elementary and hence $\mathcal Z$-stable, while for $A=C(X)$ and amenable $G$ the condition is equivalent to almost finiteness of $G\curvearrowright X$.}
}

@misc{marcelolacajoint,
  title        = {{Marcelo Laca (joint with Camila F}},
  key          = {Marcelo Laca (joint with Camila F},
  url          = {https://www.fields.utoronto.ca/talk-media/1/73/31/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/73/31/slides.pdf}},
  keywords     = {math.FA, math.OA, math.PR, mathematics, free-probability, functional-analysis, talk},
  abstract     = {Marcelo Laca (joint with Camila F. Sehnem), constructible right ideals and foundation-set relations give the full boundary quotient of a semigroup Toeplitz algebra and a criterion for its reduced quotient to be purely infinite simple. Key computation: for $P\subseteq G$, neutral words $\alpha$ produce projections $L_{\dot\alpha}=1_{K(\alpha)}$, and adjoining $\prod_{\beta\in F}(w_{\dot\alpha}-w_{\dot\beta})=0$ for every foundation cover $\bigcup_{\beta\in F}K(\beta)\subseteq K(\alpha)$ yields canonical isomorphisms $\mathcal C\rtimes_{\mathcal C P}P\cong C^*(w_p\mid\mathrm{(T1)-(T5)})\cong C(\partial\Omega_P)\rtimes_u G$; boundary topological freeness, equivalently condition $\mathrm{(BTF)}$, then makes $C(\partial\Omega_P)\rtimes_rG$ purely infinite simple, recovering this for $P=R\rtimes R^\times$ by explicitly choosing $s=(0,ac)$ or $s=(0,ac\bar x r)$ so that $psP\cap qsP=\varnothing$.}
}

@misc{gelupopescu,
  title        = {{Gelu Popescu}},
  key          = {Gelu Popescu},
  url          = {https://www.fields.utoronto.ca/talk-media/1/39/66/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/39/66/slides.pdf}},
  keywords     = {math.KT, math.AT, mathematics, k-theory, algebraic-geometry, operator-algebras, representation-theory},
  abstract     = {Gelu Popescu, noncommutative Berezin kernels give a unique Wold decomposition and classify pure representations of the $C^*$-algebra of a noncommutative variety by multiplicity. Key computation: for $V_i=\pi(B_i)$ and $\Phi_{f,V}(Y)=\sum_{|\alpha|\ge1}a_\alpha V_\alpha YV_\alpha^*$, the projections $P_{\mathcal K_1}=\operatorname*{SOT-lim}_{s\to\infty}\Phi_{f,V}^s(I)$ and $P_{\mathcal K_0}=I-P_{\mathcal K_1}$ split $\mathcal K=\mathcal K_0\oplus\mathcal K_1$ into pure and Cuntz tuples; on $\mathcal K_0$, the constrained Berezin kernel is unitary and $V_i=K_{f,V,Q}^*(B_i\otimes I_{\mathcal D})K_{f,V,Q}$ with $\mathcal D=\operatorname{ran}(I-\Phi_{f,V})^m(I)^{1/2}$, so pure representations are unitarily equivalent exactly when $\dim\mathcal D$ agrees.}
}

@misc{leonelrobert,
  title        = {{Leonel Robert}},
  key          = {Leonel Robert},
  url          = {https://www.fields.utoronto.ca/talk-media/1/25/20/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/25/20/slides.pdf}},
  keywords     = {math.OA, mathematics, operator-algebras},
  abstract     = {Leonel Robert, commutator subgroups of connected invertibles and unitaries in a unital $C^*$-algebra admit explicit exponential generators and strong simplicity properties. Key computation: the local Campbell--Baker--Hausdorff/Kashiwara--Vergne identities $e^xe^y=e^{x+y+[x,a]+[y,b]}$ and $e^{x+y}=(e^Re^xe^{-R})(e^Se^ye^{-S})$ show $e^{x+y}$ is commutator-equivalent to $e^xe^y$; consequently $D\mathrm{GL}_0(A)=\langle e^{[c,d]}:c,d\in A\rangle$ and $D\mathrm U_0(A)=\langle e^{i[x^*,x]}:x\in A\rangle$, and if $A$ has no one-dimensional representations then these groups are perfect, with $D\mathrm{GL}_0(A)$ generated by $1+x$ for $x^2=0$.}
}

@misc{camilaf,
  title        = {{Camila F}},
  key          = {Camila F},
  url          = {https://www.fields.utoronto.ca/talk-media/1/73/61/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/73/61/slides.pdf}},
  keywords     = {math.OA, math.PR, mathematics, operator-algebras, probability, talk},
  abstract     = {Camila F. Sehnem (joint with Zahra Afsar, Marcelo Laca, and Jacqui Ramagge), the KMS$_\beta$ simplex of a Toeplitz noncommutative torus is classified by probability measures on a torus determined by the degeneracy of its zero-energy block. Key computation: for $r=(r_1,\ldots,r_k,0_d)$, every KMS state satisfies $\varphi(L_pL_xL_y^*L_q^*)=\delta_{p,q}e^{-\beta\langle p,r\rangle}\varphi(L_xL_y^*)$ and is obtained from a trace $\omega$ on $Q\mathcal T_r(\mathbb N^n,\sigma_\Theta)Q$ by $T_\beta(\omega)(X)=Z(\beta)^{-1}\sum_{l\in\mathbb N^k\times0_d}e^{-\beta\langle l,r\rangle}\omega(QL_l^*XL_lQ)$, where $Q=\prod_{j=1}^k(1-L_{e_j}L_{e_j}^*)$ and $Z(\beta)=\sum_pe^{-\beta\langle p,r\rangle}$; since traces on $A_{\Theta_d}$ are states on $Z(A_{\Theta_d})\cong C(\mathbb T^m)$, this gives $\operatorname{KMS}_\beta\cong\mathcal M_1(\mathbb T^m)$.}
}

@misc{sarahreznikoffjoint,
  title        = {{Sarah Reznikoff (joint with Jonathan Brown}},
  key          = {Sarah Reznikoff (joint with Jonathan Brown},
  url          = {https://www.fields.utoronto.ca/talk-media/1/73/49/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/73/49/slides.pdf}},
  keywords     = {math.CO, math.OA, mathematics, graph-theory, operator-algebras, talk},
  abstract     = {Sarah Reznikoff (joint with Jonathan Brown, Adam Fuller, and David Pitts), regular ideals of a $C^*$-algebra are classified by invariant regular ideals of a regular subalgebra, and regular graph-algebra quotients preserve Condition (L). Key computation: for a regular inclusion $B\subseteq A$ with faithful invariant expectation $E:A\to B$ and regular ideal intersection property, $J\mapsto J\cap B$ and $K\mapsto J_K=\{a\in A:E(a^*a)\in K^{\perp\perp}\}$ are inverse Boolean-algebra isomorphisms between regular ideals of $A$ and invariant regular ideals of $B$; for graph algebras, $J=J^{\perp\perp}$ is equivalent to $p_w\in J\Longleftrightarrow(\forall v\in T(w))(\exists u\in T(v))\,p_u\in H(J)$, which forces every cycle of $E/J$ to retain an entrance and hence preserves Condition (L).}
}

@misc{paulskoufranis,
