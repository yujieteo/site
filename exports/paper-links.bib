  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/39/29/slides.pdf}},
  keywords     = {math.OA, math.RA, math.NA, mathematics, linear-algebra, operator-algebras, talk},
  abstract     = {Ra\'ul E. Curto (joint with In Sung Hwang and Woo Young Lee), Potapov's factorization theorem extends from matrices to rational two-sided inner operator-valued functions. Key computation: rationality is defined by the Hankel-kernel condition $\theta H^2(\mathbb T,E)\subseteq\ker H_{\Phi^*}$ for a finite Blaschke product $\theta$; if an inner $\Delta$ divides $\Theta=\theta I_E$, then $\Delta$ is a finite product of Blaschke--Potapov factors $b_\alpha P_M+(I_E-P_M)$, and the Beurling--Lax--Halmos identity $\ker H_{\Phi^*}=\Delta H^2$ yields the coprime factorization $\Phi=\Delta A^*$; consequently a two-sided inner $\Phi\in H^\infty(\mathbb T,B(E))$ is rational exactly when it is a finite Blaschke--Potapov product.}
}

@misc{ryanoloughlin,
  title        = {{Ryan O'Loughlin}},
  key          = {Ryan O'Loughlin},
