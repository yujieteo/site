  abstract     = {Bin Zhao, slopes of modular forms and the ghost conjecture. Key computation: for normalized $f\in S_k(\Gamma_1(N))$ with $p\mid N$, the slope of $f$ is $v_p(a_p)$ for the $U_p$-eigenvalue $a_p$; a ghost map built from the ghost components of a Witt-vector-like ring on the space of modular forms gives an algorithm computing the Newton slopes of $U_p$, and the ghost conjecture (Buzzard) states this ghost map computes slopes exactly, verified in explicit slope tables for small $p,N$.}
}

@misc{zhang,
