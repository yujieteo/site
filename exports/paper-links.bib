  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/69/88/slides.pdf}},
  keywords     = {math.CO, mathematics, graph-theory, extremal-combinatorics, probabilistic-combinatorics},
  abstract     = {Stevo Todorcevic, the Ne\v{s}et\v{r}il--R\'odl ordered expansion canonizes finite-arity relations on the random graph and identifies the universal minimal flow of its automorphism group. Key computation: for a finite graph $A$ on $\{0,\ldots,k-1\}$, $C_A=\operatorname{Emb}(A,R)=\{\bar x\in\mathbb N^{(k)}:(i,j)\in E_A\Longleftrightarrow(x_i,x_j)\in R\}$ splits under a homogeneous order $<^*$ into $C_A^\sigma=\{\bar x\in C_A:x_{\sigma(0)}<^*\cdots<^*x_{\sigma(k-1)}\}$; every $S\subseteq\mathbb N^{(k)}$ is constant on each $C_A^\sigma$ after restriction to an arbitrarily large finite induced subgraph, all $k!$ classes remain essential, and this Ramsey-plus-ordering computation makes the natural action $\operatorname{Aut}(R)\curvearrowright\operatorname{LO}(\mathbb N)$ minimal and universal.}
}

@misc{morrisang,
  title        = {{Morris Ang}},
  key          = {Morris Ang},
  url          = {https://www.fields.utoronto.ca/talk-media/2/41/70/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/2/41/70/slides.pdf}},
  keywords     = {math.DS, math.PR, cond-mat.stat-mech, math-ph, mathematics, physics, ode-and-dynamical-systems, statistical-mechanics},
  abstract     = {Morris Ang, Gaussian multiplicative chaos constructs Liouville quantum gravity surfaces and the DOZZ three-point function computes the universal critical-percolation three-point connectivity constant. Key computation: for $0<\gamma<2$, $A_h^\gamma(dz)=\lim_{\varepsilon\to0}\varepsilon^{\gamma^2/2}e^{\gamma h_\varepsilon(z)}dz$ obeys $A_{h+f}^\gamma=e^{\gamma f}A_h^\gamma$ and $f_*A_h^\gamma=A_{\widetilde h}^\gamma$ under $h=\widetilde h\circ f+(2/\gamma+\gamma/2)\log|f'|$; the resulting DOZZ correlation proves the Delfino--Viti formula $P_3(z_1,z_2,z_3)/\sqrt{P_2(z_1,z_2)P_2(z_2,z_3)P_2(z_3,z_1)}=\bigl[C_{\sqrt{8/3}}^{\mathrm{DOZZ}}(7\sqrt6/12,7\sqrt6/12,7\sqrt6/12)\bigr]^{-1}\times(\text{explicit Gamma factors})\approx1.022$.}
}

@misc{liatkesslerjoint,
  title        = {{Liat Kessler (joint work with Pranav Chakravarthy}},
  key          = {Liat Kessler (joint work with Pranav Chakravarthy},
  url          = {https://www.fields.utoronto.ca/talk-media/2/49/31/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/2/49/31/slides.pdf}},
  keywords     = {math.CO, math.SG, math.CV, math.AG, mathematics, graph-theory, symplectic-geometry, complex-geometry, talk},
  abstract     = {Liat Kessler (joint work with Pranav Chakravarthy, River Chiang, and Martin Pinsonnault), equivariant symplectic blowups of a Hamiltonian circle four-manifold at a fixed component are connected from deformation to isotopy using decorated-graph classification and inflation. Key computation: an embedded $J$-holomorphic surface $Z$ produces $J$-taming forms in the classes $[\omega_t]=[\omega]+t\lambda\operatorname{PD}[Z]$ for $0\le\lambda<T$, where $T=\infty$ if $Z\cdot Z\ge0$ and $T=\omega(Z)/(-Z\cdot Z)$ otherwise; applying this family inflation to two $S^1$-equivariant blowups of equal size, whose Karshon decorated graphs coincide, changes the invariant deformation to a cohomologous path, and equivariant Moser then writes $\omega_t=\phi_t^*\omega_0$, giving equivariant isotopy.}
}

@misc{zhilu,
  title        = {{Zhi L\'u (joint work with Wei Wang)}},
  key          = {Zhi L\'u (joint work with Wei Wang)},
  url          = {https://www.fields.utoronto.ca/talk-media/1/23/15/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/23/15/slides.pdf}},
  keywords     = {math.AT, math.GT, math.SG, mathematics, cobordism, equivariant-topology, symplectic-geometry, talk},
  abstract     = {Zhi L\'u (joint work with Wei Wang), equivariant cohomology Chern numbers form a complete system of invariants for unitary $T^k$-bordism, and mixed equivariant characteristic numbers separate equivariant Hamiltonian bordism. Key computation: the universal toric genus $\Phi:\Omega_*^{U,T^k}\to MU^*(BT^k)$ is tested by the Kronecker pairing $\langle\Phi([M]_{T^k}),[f:N\to BT^k]\rangle=[\widetilde f^*(ET^k\times_{T^k}M)]\in MU_*=\Omega_*^U$; the stable tangent splitting $T\widetilde f^*(ET^k\times_{T^k}M)\cong\pi'^*TN\oplus\widetilde f^*(ET^k\times_{T^k}TM)$ expresses every Chern number through equivariant Chern numbers of $M$, so their vanishing kills every pairing, gives $\Phi([M]_{T^k})=0$, and injectivity of $\Phi$ yields $[M]_{T^k}=0$.}
}

@misc{stevotodorcevica,
  title        = {{Stevo Todorcevic}},
  key          = {Stevo Todorcevic},
  url          = {https://www.fields.utoronto.ca/talk-media/1/69/90/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/69/90/slides.pdf}},
  keywords     = {math.RT, math.AG, math.RA, mathematics, quiver-representations, enumerative-geometry},
  abstract     = {Stevo Todorcevic, analytic $n^*$-gaps have a finite basis of minimal equivalence types, obtained by canonizing their tree presentations. Key computation: for gaps $\Gamma$ on $N$ and $\Delta$ on $M$, $\Gamma\le\Delta$ is witnessed by an injection $\phi:N\to M$ carrying $\Gamma_i$ into $\Delta_i$ and $\Gamma_i^\perp$ into $\Delta_i^\perp$; the tree partition theorem produces, from any non-separated analytic family $\Gamma=\{\Gamma_i:i<n\}$, a permutation $\varepsilon:n\to n$ and injection $u:n^{<\omega}\to N$ with $u[X]\in\Gamma_{\varepsilon(i)}$ for every chain $X$ of type $[i]$, reducing every analytic gap to one of finitely many minimal types--exactly five for $n=2$ up to permutation--and yielding the sharp intersection numbers $J(1),\ldots,J(7)=1,8,61,480,3881,31976,266981$.}
}

@misc{jeffachter,
  title        = {{Jeff Achter}},
  key          = {Jeff Achter},
  url          = {https://www.fields.utoronto.ca/talk-media/1/34/25/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/34/25/slides.pdf}},
  keywords     = {math.AG, mathematics, algebraic-geometry, moduli-spaces, hodge-theory, shimura-varieties},
  abstract     = {Jeff Achter, cyclic covers turn moduli of genus-$4$ curves, plane quartics, and five marked points on $\mathbb P^1$ into arithmetic period maps to unitary Shimura varieties. Key computation: for a canonical genus-$4$ curve $C=Q\cap S\subset\mathbb P^3$, the triple cover $v:Z\to Q$ branched along $C$ is a K3 surface; the inverse images $N_i=v^{-1}(M_i)$ of the two rulings satisfy $(N_1,N_2)=3$, so $U(3)=\mathbb ZN_1+\mathbb ZN_2\hookrightarrow\operatorname{Pic}(Z)$ and the deck $\mu_3$-action produces $(Z,\alpha,\rho)\in\mathcal R_{(L_4,\chi_4)}$. Over $\mathbb Z[\zeta_3,1/6]$, $\kappa_4:\mathcal R_{(L_4,\chi_4)}\to\mathcal N_4$ induces an isomorphism on coarse moduli spaces and $\tau_4$ is an open immersion into $\operatorname{Sh}(L_4,\chi_4)$.}
}

@misc{youshengshi,
  title        = {{Yousheng Shi}},
  key          = {Yousheng Shi},
  url          = {https://www.fields.utoronto.ca/talk-media/1/41/43/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/41/43/slides.pdf}},
  keywords     = {math.AG, mathematics, birational-geometry, geometric-invariant-theory, singularities},
  abstract     = {Yousheng Shi, derived intersections of Kudla--Rapoport divisors on ramified unitary Rapoport--Zink spaces equal a corrected derivative of local representation densities in ranks $n\le3$. Key computation: blowing up the isolated singularities of $\mathcal N_n^{\mathrm{Pap}}$ gives the regular semistable Kr\'amer model $\mathcal N_n^{\mathrm{Kra}}$, and for $L=\langle x_1,\ldots,x_n\rangle$ the intersection is $\operatorname{Int}(L)=\chi(\mathcal N_n,\mathcal O_{\mathcal Z(x_1)}\otimes^{\mathbf L}\cdots\otimes^{\mathbf L}\mathcal O_{\mathcal Z(x_n)})$. Solving the triangular system $2\alpha'(M_j,M)/\alpha(M,M)+\sum_{i=1}^{n-1}c_i\alpha(M_j,M_i)=0$ produces the correction terms and the formula $\operatorname{Int}(L)=2\alpha'(L,M)/\alpha(M,M)+\sum_{i=1}^{n-1}c_i\alpha(L,M_i)$; for $n=3$, the difference-cycle identity $\mathbb L D^{\mathrm{Kra}}(L)\cdot\mathcal Z^{\mathrm{Kra}}(x)=\beta(L\oplus\{x\},M)(2)$ reduces the proof inductively to $n=2$.}
}

@misc{somnathjha,
  title        = {{Somnath Jha}},
  key          = {Somnath Jha},
  url          = {https://www.fields.utoronto.ca/talk-media/1/30/69/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/30/69/slides.pdf}},
  keywords     = {math.NT, math.CT, math.KT, math.AG, mathematics, elliptic-curves, homological-algebra, k-theory, l-functions},
  abstract     = {Somnath Jha, Pontryagin dual Selmer groups over noncommutative $p$-adic Lie extensions satisfy an algebraic functional equation, including the local Euler-factor error term. Key computation: twisting by a continuous character $\theta:\Gamma_{\mathrm{cyc}}\to\mathbb Z_p^\times$ makes the control maps $r_{U,A}^{\theta}$ have finite kernels and cokernels; under the stated $\mathfrak M_H(G)$ and Ext-vanishing hypotheses this yields $[S(A/K_\infty)^\vee]+[E_0^{A^*(1)}]=[S(A^*(1)/K_\infty)^\vee]$ in $K_0(\mathfrak M_H(G))$. For the false-Tate extension and a squarefree-level ordinary newform of weight $k$ at the central twist, the correction is $[E_0^A]=[\bigoplus_{q\in P_1\cup P_2}\operatorname{Ind}_{G_q}^G T(-1)]$ and evaluates at an Artin representation $\eta$ as $\eta(\xi_{E_0^A})=\prod_{q\in P_1\cup P_2}P_q(f,\eta,q^{-k/2})/P_q(f,\eta^*,q^{-k/2})$ modulo $p$-adic units.}
}

@misc{maheshkakdejoint,
  title        = {{Mahesh Kakde (joint with Samit Dasgupta)}},
  key          = {Mahesh Kakde (joint with Samit Dasgupta)},
  url          = {https://www.fields.utoronto.ca/talk-media/1/26/64/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/26/64/slides.pdf}},
  keywords     = {math.NT, mathematics, algebraic-number-theory, number-theory, talk},
  abstract     = {Mahesh Kakde (joint with Samit Dasgupta), the integral Gross--Stark theorem proves the strong Brumer conjecture and gives a $p$-adic class-field construction from Brumer--Stark units. Key computation: the Stickelberger element satisfies $\chi(\Theta_q^{H/F})=L_R(\chi^{-1},0)(1-\chi^{-1}(q)Nq)$ and $\Theta_q^{H/F}\in\operatorname{Fitt}_{\mathbb Z[G]}(\operatorname{Cl}_q(H)^{\vee,-})$; hence for a split prime $\mathfrak p$ its class is principalized by the unique unit $u$ with $\sum_{\sigma\in G}[\sigma^{-1}]\operatorname{ord}_{\mathfrak P}(\sigma u)=\Theta_q^{H/F}$. For $S=\{\mathfrak p_i:\chi(\mathfrak p_i)=1\}$, the proved Gross--Stark formula computes the leading term $L_p^{(r)}(\chi\omega,0)/(r!L(\chi,0)\prod_{\chi(\mathfrak p)\ne1}(1-\chi(\mathfrak p)))=\det(\log_pN_{F_{\mathfrak p_i}/\mathbb Q_p}u_j)/\det(\operatorname{ord}_{\mathfrak P_i}u_j)$, while in rank one $\chi(\Theta_q^{H_{\mathrm{cyc}}/F})=\sum_{\sigma\in G}\chi(\sigma^{-1})(\operatorname{rec}(\sigma u)-1)$ in $I/I^2$.}
}

@misc{tiagoj,
  title        = {{Tiago J}},
  key          = {Tiago J},
  url          = {https://www.fields.utoronto.ca/talk-media/1/51/38/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/51/38/slides.pdf}},
  keywords     = {math.AG, math.NT, math.AT, mathematics, chromatic-homotopy-theory, elliptic-curves, motives, schemes, talk},
  abstract     = {Tiago J. Fonseca (joint with Nils Matthes), the universal vector extension gives an algebraic classification of all relatively unipotent integrable connections on a punctured elliptic curve and recovers Brown--Levin elliptic multiple polylogarithms. Key computation: for $0\to V(R^1f_*\mathcal O_E)\to E^\natural\xrightarrow{\pi}E\to0$ and $D=\pi^{-1}(O)$, Laumon's vanishing $g_*\mathcal O_{E^\natural}\simeq\mathcal O_S$, $R^ng_*\mathcal O_{E^\natural}=0$ combines with $g_*\Omega^1_{E^\natural/S}(\log D)=g_*\Omega^1_{E^\natural/S}\oplus\bigoplus_{n\ge1}K(n)$, where $d\omega^{(n)}=\nu\wedge\omega^{(n-1)}$ and $\operatorname{Res}_D\omega^{(n)}=t^{n-1}/(n-1)!$. Every such connection is therefore canonically $d+A\otimes\nu+B_0\otimes\omega^{(0)}+\sum_{n\ge1}\operatorname{ad}_A^n(B_0)\otimes\omega^{(n)}$, and $\pi_1^{\mathrm{dR}}(E\setminus\{O\},x)\simeq\operatorname{Spec}(\bigoplus_{n\ge0}H^1_{\mathrm{dR}}(E/k)^{\otimes n})$.}
}

@misc{arulshankarjoint,
  title        = {{Arul Shankar (joint with Manjul Bhargava and Jonathan Hanke)}},
  key          = {Arul Shankar (joint with Manjul Bhargava and Jonathan Hanke)},
  url          = {https://www.fields.utoronto.ca/talk-media/1/33/67/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/33/67/slides.pdf}},
  keywords     = {math.NT, mathematics, arithmetic-statistics, algebraic-number-theory, quadratic-forms, talk},
  abstract     = {Arul Shankar (joint with Manjul Bhargava and Jonathan Hanke), local ramification densities determine the average $2$-torsion in class groups of fixed-index monogenic cubic fields. Key computation: pairs of ternary quadratic forms $V=\mathbb Z^2\otimes\operatorname{Sym}^2(\mathbb Z^3)$ have resolvent $\operatorname{Res}(A,B)=4\det(Ax+B)$, and Bhargava's bijection identifies $\operatorname{SL}_3(\mathbb Z)$-orbits in $\operatorname{Res}^{-1}(f)$ with index-$2$ subgroups of $\operatorname{Cl}(K)$ when $f$ defines $\mathcal O_K$. Fixing leading coefficient $n$ imposes $\det A=n/4$; counting the resulting $\operatorname{SO}_A(\mathbb Z)$-orbits and evaluating $\operatorname{Mass}_p(f)=\sum_{(A,B)}|\operatorname{Stab}(A,B)|^{-1}=1$ gives, for $n=m^2k$ and $\rho(\mathcal F)=\prod_{p\mid k}\rho_p(\mathcal F)$, the exact averages $\operatorname{Avg}_{\mathcal F,\mathrm{real}}|\operatorname{Cl}_2(K)|=5/4+\rho(\mathcal F)/4$ and $\operatorname{Avg}_{\mathcal F,\mathrm{complex}}|\operatorname{Cl}_2(K)|=3/2+\rho(\mathcal F)/2$.}
}

@misc{taraspanov,
  title        = {{Taras Panov}},
  key          = {Taras Panov},
  url          = {https://www.fields.utoronto.ca/talk-media/1/26/06/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/26/06/slides.pdf}},
  keywords     = {math.CO, math.GR, math.AT, math.GT, mathematics, algebraic-combinatorics, algebraic-topology, geometric-group-theory, graph-theory},
  abstract     = {Taras Panov, polyhedral products classify when graph-product classifying spaces are aspherical and when commutator subgroups of right-angled Coxeter groups are free or one-relator. Key computation: the fibration $(EG,G)_K\to(BG)_K\to\prod_{i=1}^mBG_i$ gives $1\to\pi_1((EG,G)_K)\to G_K\to\prod_iG_i\to1$; a missing face $J$ of size $k\ge3$ has fat-wedge fibre $\Sigma^{k-1}G_{j_1}\wedge\cdots\wedge G_{j_k}$ and hence nonzero $\pi_{k-1}$, proving asphericity exactly when $K$ is flag. For $G_i=\mathbb Z/2$, $\pi_1((D^1,S^0)_K)=RC_K'$; it is free exactly when $K^1$ is chordal, and it is one-relator exactly when $K=C_p$ or $C_p*\Delta^q$, equivalently $H_2((D^1,S^0)_K)=\mathbb Z$; for $K=C_m$ the space is the orientable surface of genus $(m-4)2^{m-3}+1$.}
}

@misc{nimahoda,
  title        = {{Nima Hoda}},
  key          = {Nima Hoda},
  url          = {https://www.fields.utoronto.ca/talk-media/1/26/02/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/26/02/slides.pdf}},
  keywords     = {math.CO, math.AC, math.AT, mathematics, graph-theory, algebraic-topology, commutative-algebra, extremal-combinatorics},
  abstract     = {Nima Hoda, bisimplices give a canonical higher-dimensional completion of complete bipartite subgraphs, and filling every $K_{m+1,n+1}$ in a locally finite quadric complex produces a contractible complex with unchanged $2$-skeleton. Key computation: the $(m,n)$-bisimplex $\nabla\!\Delta^{m,n}$ is built inductively by placing one $\nabla\!\Delta^{m',n'}$ on each proper $K_{m'+1,n'+1}$ and then attaching an $(m+n)$-cell to $\partial\nabla\!\Delta^{m,n}$. An explicit discrete Morse matching on this boundary has exactly two critical cells, so $\partial\nabla\!\Delta^{m,n}\simeq S^{m+n-1}$; the link of every cell has the same two-critical-cell matching, hence induction makes every link a sphere, and the generalized Poincar\'e theorem upgrades the homotopy equivalence to $\partial\nabla\!\Delta^{m,n}\cong S^{m+n-1}$, proving $\nabla\!\Delta^{m,n}\cong B^{m+n}$.}
}

@misc{victorbuchstaber,
  title        = {{Victor Buchstaber}},
  key          = {Victor Buchstaber},
  url          = {https://www.fields.utoronto.ca/talk-media/1/24/62/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/24/62/slides.pdf}},
  keywords     = {math.AT, math.GT, mathematics, cobordism, chromatic-homotopy-theory},
  abstract     = {Victor Buchstaber, partially framed manifolds give explicit generators and characteristic numbers for complex bordism and compute the complex cobordism of $\Omega SU(2)\simeq\Omega S^3$. Key computation: the hypersurface $M_{2n}\subset(\mathbb{CP}^{1}_{*})^{n+1}$ Poincar\'e dual to $\eta_1\otimes\cdots\otimes\eta_{n+1}$ generates $(\mathrm{fr}(1),U)_{2n}\cong\mathbb Z$ and has $\operatorname{Td}(M_{2n})=(-1)^n$, $c_n(M_{2n})=(-1)^n(n+1)!$, and $\tau(M_{2n})=4^{n+1}(4^{n+1}-1)B_{2n+2}/(2n+2)$. The James equivalence $J(S^2)\simeq\Omega S^3$ then yields $U_*(\Omega S^3)\cong\Omega_U[w]$ and $U^*(\Omega S^3)\cong\Omega_U[[b_2,b_4,\ldots]]/(b_2^n-n!b_{2n})_{n\ge2}$, with $b_{2i}b_{2j}=\binom{i+j}{i}b_{2(i+j)}$ and $\varphi_U^*u=b_2+\sum_{n\ge1}[M_{2n}]b_{2n+2}$.}
}

@misc{luisscoccola,
  title        = {{Luis Scoccola}},
  key          = {Luis Scoccola},
  url          = {https://www.fields.utoronto.ca/talk-media/1/26/87/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/26/87/slides.pdf}},
  keywords     = {math.AT, math.CT, math.PR, mathematics, algebraic-topology, category-theory, probability, slides},
  abstract     = {Luis Scoccola, the Gromov--Hausdorff distance is universally characterized as a quotient interleaving distance, making homotopy and density filtrations stable functors of metric data. Key computation: for pseudometric spaces, let $d_I(P,Q)$ be the infimum of $\delta$ admitting inverse set maps that increase distances by at most $\delta$, and quotient by zigzags of surjective distance-preserving maps; the slides prove $(d_I)/{\simeq}=2d_{\mathrm{GH}}$. Consequently the Vietoris--Rips functor is $2$-Lipschitz into homotopy interleaving distance, while the bifiltration $\operatorname{KDF}(X)(s,k)=\{x\in X:\int_XK(d_X(x,x')/s)\,d\mu_X(x')\ge k\}$ is uniformly continuous from Gromov--Hausdorff--Prokhorov distance to Gromov--Hausdorff interleaving distance; for full-support $X$ and iid samples $X_n$, $\operatorname{KDF}(X_n)\to\operatorname{KDF}(X)$ in probability.}
}

