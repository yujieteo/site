@misc{adelicclassicalmodular,
  title        = {{Adelic and Classical Modular Forms for GL(2)}},
  key          = {Adelic and Classical Modular Forms for GL(2)},
  url          = {https://math.uchicago.edu/~emerton/gl2.pdf},
  howpublished = {\url{https://math.uchicago.edu/~emerton/gl2.pdf}},
  keywords     = {math.NT, math.RT, mathematics, adeles, modular-forms, lie-theory, complex-geometry, automorphic-forms, survey},
  abstract     = {Adelic and Classical Modular Forms for GL(2). An exposition of the translation between classical modular forms and automorphic forms on the adelic group $\mathrm{GL}_2(\mathbb{A}_{\mathbb{Q}})$. Provides a geometric interpretation of modular forms as sections of line bundles over modular curves, along with minimal ad hoc constructions of Eisenstein series. Details the Lie algebra $\mathfrak{gl}_2(\mathbb{R})$ with basis elements $Z, H, Y_+, Y_-$, where the center $\mathcal{Z}(\mathfrak{gl}_2)$ of the universal enveloping algebra is isomorphic to a polynomial ring in two generators. Explores the space of bases $B$ of $\mathbb{C}$ as a real vector space, identifying it as an open subset of $\mathbb{C}^2$ with commuting left and right actions by $\mathrm{GL}_2(\mathbb{R})$ and $\mathrm{GL}_1(\mathbb{C})$. The right action of $\mathrm{GL}_2(\mathbb{R})$ is complex analytic and gives an identification with the upper half-plane $\mathcal{H}^{\pm} \times \mathbb{C}^\times$ via $(\tau, z) \mapsto \left(\frac{a\tau+c}{b\tau+d}, (b\tau+d)z\right)$. Examines the complexified Lie algebra tangent space decomposition into holomorphic and anti-holomorphic subspaces, the subspace $V_i \subset \mathfrak{gl}_2$, and the bijection $B/\mathrm{GL}_2(\mathbb{Z}) \cong \mathcal{L}$ with the moduli of discrete rank-2 lattices. Covers moderate growth conditions, smooth adelic automorphic forms, and representations invariant under right translation by $\mathrm{GL}_2(\mathbb{A}_f)$.}
}

