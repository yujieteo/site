  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/45/66/slides.pdf}},
  keywords     = {math.FA, mathematics, functional-analysis},
  abstract     = {Ryan O'Loughlin, compact truncated Toeplitz operators on a model space have continuous inner-multiple symbols exactly under the same conditions that give bounded symbols for all bounded truncated Toeplitz operators. Key computation: for $K_I^2=H^2\ominus IH^2$ and $A_g^I f=P_I(gf)$, the projective product space $X=\{\sum_kx_ky_k:\sum_k\|x_k\|_2\|y_k\|_2<\infty\}$ satisfies $X^*=\mathcal T(I)$ and ${}^*X=\mathcal T_c(I)$; the maps $S:X\to zH^1\cap K_{I^2}^1$, $f\mapsto If$, ${}^*S:C(\mathbb T)/(F_{I^2}\cap C(\mathbb T))\to\mathcal T_c(I)$, $[f]\mapsto A_{If}^I$, and $S^*:L^\infty/Q\to\mathcal T(I)$ identify their images with compact operators having symbols in $I C(\mathbb T)$ and bounded-symbol operators, so duality gives $\mathcal T_c(I)=\{A_{Ih}^I:h\in C(\mathbb T)\}$ if and only if every bounded $A_g^I$ has a bounded symbol.}
}

@misc{alfonsvandaele,
  title        = {{Alfons Van Daele}},
  key          = {Alfons Van Daele},
  url          = {https://www.fields.utoronto.ca/talk-media/1/80/15/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/80/15/slides.pdf}},
  keywords     = {math.OA, math.QA, math.RT, mathematics, operator-algebras, quantum-groups},
  abstract     = {Alfons Van Daele, the polar decomposition of the antipode determines the modular structure of a locally compact quantum group and proves uniqueness of Haar weights. Key computation: regular representations satisfy $\Delta(x)=W^*(1\otimes x)W$ and $(\Delta\otimes\iota)W=W_{13}W_{23}$, while the closed antipode has $S((\iota\otimes\omega)W)=(\iota\otimes\omega)W^*$ and polar decomposition $S=R\tau_{-i/2}$; for two left Haar weights, $(K\otimes T_r)W_1=W_2^*(K\otimes T_r)$ implies $(1\otimes u_t)W_1(1\otimes u_t^*)=W_1$, hence $\Delta(u_t)=1\otimes u_t$ and $u_t$ is scalar, proving uniqueness up to scale; relative modular theory then produces the affiliated modular element $\delta$ with $\psi=\varphi(\delta^{1/2}\,\cdot\,\delta^{1/2})$, $\Delta(\delta)=\delta\otimes\delta$, and $\sigma_t'(x)=\delta^{it}\sigma_t(x)\delta^{-it}$.}
}

@misc{jingboxia,
  title        = {{Jingbo Xia}},
  key          = {Jingbo Xia},
  url          = {https://www.fields.utoronto.ca/talk-media/1/39/73/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/39/73/slides.pdf}},
  keywords     = {math.CA, math.NT, math.OA, mathematics, harmonic-analysis, cyclotomic-fields, operator-algebras},
  abstract     = {Jingbo Xia, the Drury--Arveson space is the universal dilation space for commuting row contractions and its multiplier norm gives the correct multivariable von Neumann inequality. Key computation: for a strict commuting row contraction $A=(A_1,\ldots,A_n)$, the identity $\sum_{\alpha\in\mathbb Z_+^n}\frac{|\alpha|!}{\alpha!}A^\alpha(I-\sum_iA_iA_i^*)A^{*\alpha}=I$ makes $Zx=\sum_\alpha\frac{|\alpha|!}{\alpha!}(I-\sum_iA_iA_i^*)^{1/2}A^{*\alpha}x\,\zeta^\alpha$ an isometry into $H_n^2\otimes H$ satisfying $Zp(A^*)=(p(M_\zeta^*)\otimes I)Z$; hence $\|p(A)\|\leq\|p\|_{\operatorname{Mult}(H_n^2)}$, while for $\theta(\zeta)=\zeta_1\cdots\zeta_n$ one has $\|\theta^k\|_\infty=n^{-kn/2}$ but $\|\theta^k\|_{H_n^2}=((k!)^n/(nk)!)^{1/2}\asymp k^{(n-1)/4}n^{-kn/2}$, explicitly showing why the supremum norm cannot replace the multiplier norm for $n\ge2$.}
}

@misc{ilijasfarah,
  title        = {{Ilijas Farah}},
  key          = {Ilijas Farah},
  url          = {https://www.fields.utoronto.ca/talk-media/1/33/03/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/33/03/slides.pdf}},
  keywords     = {math.LO, math.OA, mathematics, descriptive-set-theory, operator-algebras},
  abstract     = {Ilijas Farah, set-theoretic saturation sharply classifies ultrapowers of separable $C^*$-algebras: CH makes all nonprincipal ultrapowers isomorphic, while failure of CH yields the maximal number of isomorphism types. Key computation: countably saturated elementarily equivalent structures $C,D$ of density $\aleph_1$ are written as continuous chains $C=\bigcup_{\alpha<\omega_1}C_\alpha$ and $D=\bigcup_{\alpha<\omega_1}D_\alpha$; a transfinite back-and-forth constructs compatible elementary embeddings whose unions are inverse isomorphisms, so under CH, $A^{\mathcal U}\cong A^{\mathcal V}$ commuting with the diagonal copy of every separable $A$ and $A'\cap A^{\mathcal U}\cong A'\cap A^{\mathcal V}$; conversely, if CH fails, every separable infinite-dimensional $A$ has $2^{2^{\aleph_0}}$ nonisomorphic ultrapowers and as many nonisomorphic relative commutants.}
}

@misc{guoliangyu,
