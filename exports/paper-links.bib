  keywords     = {math.OA, math.QA, math.RT, mathematics, operator-algebras, quantum-groups},
  abstract     = {Alfons Van Daele, a locally compact quantum group defined by central Haar weights on a $C^*$-algebra canonically yields a faithful von Neumann algebraic locally compact quantum group. Key computation: a lower-semicontinuous semifinite weight extends by $\widetilde\varphi(x)=\sup_{\omega\le\varphi}\omega(x)$ to a normal weight on $A^{**}$, and Haar invariance $\varphi((\omega\otimes\iota)\Delta(a))=\omega(1)\varphi(a)$ implies that the support projections $e$ and $f$ of the extended left and right weights satisfy $\widetilde\Delta(1-e)(1\otimes(1-e))=0$, hence $f(1-e)=e(1-f)=0$ and $e=f$; cutting down to $M=A^{**}e$ gives $\Delta_0(x)=\widetilde\Delta(x)(e\otimes e)$ with faithful invariant restrictions $\varphi_0,\psi_0$, so $(M,\Delta_0)$ is the associated von Neumann algebraic quantum group.}
}

