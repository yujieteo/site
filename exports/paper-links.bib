@misc{jeffreylambiehanson,
  title        = {{Jeffrey Lambie-Hanson (joint with Chris Lambie-Hanson)}},
  key          = {Jeffrey Lambie-Hanson (joint with Chris Lambie-Hanson)},
  url          = {https://www.mv.helsinki.fi/home/jvaanane/arctic/2025/Slides/lambie-hanson_arctic25.pdf},
  howpublished = {\url{https://www.mv.helsinki.fi/home/jvaanane/arctic/2025/Slides/lambie-hanson_arctic25.pdf}},
  keywords     = {math.AG, math.AT, math.CO, math.CT, mathematics, algebraic-topology, condensed-mathematics, combinatorics, mathematical-logic, talk},
  abstract     = {Jeffrey Lambie-Hanson (joint with Chris Lambie-Hanson), infinitary combinatorics in condensed mathematics and strong homology. Key computation: for $X^{n,\lambda}$ the one-point compactification of a disjoint sum of $\lambda$ copies of the open $n$-ball, $\bar H_p(\bigvee_\omega X^{n,\lambda})=\bigoplus_\omega \bar H_p(X^{n,\lambda})$ iff $\lim^{n-p} A^{\omega}_\lambda=0$, where $A^\kappa_\lambda=\langle\prod_{I(f)}\mathbb Z\rangle$ is the inverse system attached to $f:\kappa\to[\lambda]^{<\omega}$, generalizing Mardešić–Prasolov's criterion; forcing with Hechler or $\beth_\omega$-many Laver reals kills all $\lim^n A[H]$ (yielding $2^{\aleph_0}>\aleph_\omega$ via Casarosa–Lambie-Hanson), making strong homology additive on locally compact separable metric spaces and embedding separable pro-abelian groups fully faithfully in $\mathrm{Cond}(\mathrm{Ab})$; in ZFC the uncountable earring space and $\prod_\omega\prod_{\omega_1}\mathbb{Z}$ give counterexamples, so nonseparable condensed behavior is provably bad.}
}

@misc{guozhenwang,
