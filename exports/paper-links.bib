@misc{classfieldtheory,
  title        = {{Class Field Theory and Noncommutative Geometry}},
  key          = {Class Field Theory and Noncommutative Geometry},
  url          = {https://indico.math.cnrs.fr/event/10843/contributions/12868/},
  howpublished = {\url{https://indico.math.cnrs.fr/event/10843/contributions/12868/}},
  keywords     = {math.NT, math.OA, mathematics, class-field-theory, noncommutative-geometry, adeles, algebraic-number-theory, survey},
  abstract     = {Class Field Theory and Noncommutative Geometry. An exposition by Alain Connes on class field theory through the lens of the adèle class space $X_{\mathbb{Q}} = \mathbb{Q}^\times \backslash \mathbb{A}_{\mathbb{Q}}$. Abelian extensions of a number field $K$ are encoded internally by its idele class group $C_K = \mathbb{A}_K^\times / K^\times$, acting as a Galois group of the maximal abelian extension via Artin reciprocity. Galois actions on roots are realized through group actions on spaces. The quotient space $X_K = K^\times \backslash \mathbb{A}_K$ is ergodic with respect to the Haar measure, serving as a prototype noncommutative space (leaf space of a foliation). Translates local-to-global class field theory via the inclusion of local isotropy groups $K_v^\times \hookrightarrow C_K$. Connects the Riemann–Weil explicit formulas $\sum_v \int f(u)/|1-u|\,d^*u$ to a trace formula for the scaling operator on the adèle class space. Introduces the scaling site $X_{\mathbb{Q}} = \mathbb{Q}^\times \backslash \mathbb{A}_{\mathbb{Q}} / \widehat{\mathbb{Z}}^\times$, modeled as a noncommutative space of rank-1 subgroups of $\mathbb{R}$, where periodic orbits of length $\log p$ correspond to prime numbers $p$, realizing the Frobenius endomorphism as a mapping torus. Relates this construction to Grothendieck's étale fundamental group $\pi_1^{\text{ét}}$ and the 3D topology of $\operatorname{Spec} \mathbb{Z}$.}
}

