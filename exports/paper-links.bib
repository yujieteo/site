  key          = {Dan Ursu (joint with Shirly Geffen)},
  url          = {https://www.fields.utoronto.ca/talk-media/1/73/80/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/73/80/slides.pdf}},
  keywords     = {math.OA, mathematics, operator-algebras, talk},
  abstract     = {Dan Ursu (joint with Shirly Geffen), simplicity of reduced crossed products by FC-hypercentral groups is characterized by the absence of a central corner on which a finite-conjugacy element acts inner with centralizer-invariant implementer. Key computation: for a minimal action $\alpha:G\curvearrowright A$ with $G$ FC-hypercentral, $A\rtimes_rG$ is not simple exactly when there exist $t\in\mathrm{FC}(G)\setminus\{e\}$, a nonzero $t$-invariant $p\in Z(I(A))$, and $u\in\mathcal U(I(A)p)$ such that $\alpha_t|_{I(A)p}=\operatorname{Ad}(u)$ and $\alpha_s(p)=p,\ \alpha_s(u)=u$ for every $s\in C_G(t)$; this refines proper outerness on the injective envelope and is equivalent, for separable $A$, to an intrinsic obstruction on an essential $t$-invariant ideal $J\triangleleft A$ with an implementing unitary in $M(J)$.}
}

@misc{matthewkennedy,
  title        = {{Matthew Kennedy}},
  key          = {Matthew Kennedy},
  url          = {https://www.fields.utoronto.ca/talk-media/1/39/77/slides.pdf},
  howpublished = {\url{https://www.fields.utoronto.ca/talk-media/1/39/77/slides.pdf}},
  keywords     = {math.OA, math.RA, mathematics, operator-algebras, linear-algebra, convex-analysis},
  abstract     = {Matthew Kennedy, noncommutative Choquet theory classifies operator systems by compact matrix-convex state spaces and characterizes those arising from $C^*$-algebras as noncommutative Bauer simplices. Key computation: matrix convexity closes $K=\coprod_nK_n$ under $\sum_i\alpha_i^*x_i\alpha_i$ whenever $\sum_i\alpha_i^*\alpha_i=I$, and evaluation gives the dual equivalence $S\cong A(K)$; every $x\in K_n$ has a maximal representing nc state $\mu:C(K)\to M_n$ with $a(x)=\int_Ka\,d\lambda$ supported on $\partial K$, while uniqueness of this maximal state is equivalent to $A(K)^{**}$ being a von Neumann algebra and to $A(K)\otimes_cT=A(K)\otimes_{\max}T$ for every operator system $T$; adding closed $\partial K$ characterizes precisely nc state spaces of unital $C^*$-algebras.}
}

@misc{kennethr,
