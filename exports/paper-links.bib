}

@misc{davidmartinez,
  title        = {{David Mart\'inez-Carpena (with Carles Casacuberta and Javier J}},
  key          = {David Mart\'inez-Carpena (with Carles Casacuberta and Javier J},
  url          = {http://xabier.garcia.martinez.webs.uvigo.gal/CT2024/files/Slides/Mart%C3%ADnez-Carpena_Slides.pdf},
  howpublished = {\url{http://xabier.garcia.martinez.webs.uvigo.gal/CT2024/files/Slides/Mart\%C3\%ADnez-Carpena_Slides.pdf}},
  keywords     = {math.CT, math.AG, cs.LO, math.NT, mathematics, computer-science, category-theory, field-with-one-element, type-theory},
  abstract     = {David Mart\'inez-Carpena (with Carles Casacuberta and Javier J. Guti\'errez), presentable $\infty$-categories are exactly the categories of models of limit $\infty$-sketches. Key computation: for a limit $\infty$-sketch $\Sigma=(A,L)$, $\operatorname{Mod}(\Sigma)=\{F:A\to\mathcal S\mid F(\alpha)\text{ is limiting for every }\alpha\in L\}$ is presentable, and conversely every presentable $\infty$-category $\mathcal C$ admits a normal $\Sigma$ with $\mathcal C\simeq\operatorname{Mod}(\Sigma)$; concretely, the cones $\alpha_n$ on $\Delta^{\mathrm{op}}$ impose $F_n\simeq F_1\times_{F_0}\cdots\times_{F_0}F_1$, so their models are Segal spaces, while adjoining the univalence cone produces complete Segal spaces.}
}

@misc{andrejoyal,
  title        = {{Andr\'e Joyal}},
  key          = {Andr\'e Joyal},
  url          = {http://xabier.garcia.martinez.webs.uvigo.gal/CT2024/files/Slides/Joyal_Slides.pdf},
  howpublished = {\url{http://xabier.garcia.martinez.webs.uvigo.gal/CT2024/files/Slides/Joyal_Slides.pdf}},
  keywords     = {math.AC, math.CT, mathematics, commutative-algebra, category-theory},
  abstract     = {Andr\'e Joyal, the free bicompletion of a locally small category is characterized intrinsically by softness together with atomic and co-atomic generators. Key computation: softness requires the canonical square from $\operatorname*{colim}_I\operatorname*{lim}_J\mathcal E(A_i,B_j)$ to $\mathcal E(\operatorname*{lim}_I A_i,\operatorname*{colim}_J B_j)$ to be a pushout; hence every $f:\prod_{i\in I}A_i\to\coprod_{j\in J}B_j$ factors through some projection $\prod_iA_i\to A_i$, some inclusion $B_j\to\coprod_jB_j$, or both, and $\eta:K\to\Lambda(K)$ is the free bicompletion precisely when $\Lambda(K)$ is bicomplete and soft, $\eta$ is fully faithful and generating, and each $\eta(A)$ is atomic and co-atomic.}
}

@misc{nathanaelarkordylan,
  title        = {{Nathanael Arkor and Dylan McDermott}},
  key          = {Nathanael Arkor and Dylan McDermott},
  url          = {http://xabier.garcia.martinez.webs.uvigo.gal/CT2024/files/Slides/Arkor_Slides.pdf},
  howpublished = {\url{http://xabier.garcia.martinez.webs.uvigo.gal/CT2024/files/Slides/Arkor_Slides.pdf}},
  keywords     = {math.CT, mathematics, category-theory},
  abstract     = {Nathanael Arkor and Dylan McDermott, the algebras of any relative monad rooted at a dense functor are reconstructed as a pullback along the corresponding nerve, subsuming standard nerve theorems. Key computation: for $j:A\to E$ dense and a $j$-relative monad $T$ with $\operatorname{Kl}(T)(x,y)=E(jx,ty)$, the square $\operatorname{Alg}(T)\to\widehat{\operatorname{Kl}(T)}$ over $E\xrightarrow{n_j}\widehat A$, where $n_j(e)=E(j-,e)$, is a pullback in $\operatorname{Cat}$; thus $\operatorname{Kl}(T)\hookrightarrow\operatorname{Alg}(T)$ is dense, and for an ordinary monad the analogous square is a pullback exactly when $T$ is $j$-ary, recovering algebraic theories and the Segal-nerve classification of categories.}
}

@misc{joannako,
  title        = {{Joanna Ko}},
  key          = {Joanna Ko},
  url          = {http://xabier.garcia.martinez.webs.uvigo.gal/CT2024/files/Slides/Ko_Slides.pdf},
  howpublished = {\url{http://xabier.garcia.martinez.webs.uvigo.gal/CT2024/files/Slides/Ko_Slides.pdf}},
  keywords     = {math.CT, math.AT, mathematics, category-theory, algebraic-topology, higher-category-theory},
  abstract     = {Joanna Ko, enhanced simplicial categories of $(\infty,1)$-categories with specified limits and lax morphisms admit the higher limit constructions needed for Eilenberg--Moore objects. Key computation: $J\text{-}\operatorname{Lim}$ admits rigged $n$-inserters, so in particular comma objects whose projections preserve and jointly reflect $J$-shaped limits; since a loose homotopy-coherent monad's Eilenberg--Moore object is assembled from simplicial powers, rigged $n$-inserters, and limits of countable chains of tight isofibrations, $\operatorname{Lali}(\mathcal K)$ admits such Eilenberg--Moore objects and its forgetful functor is exact and detects exactness, recovering that $U:T\text{-}\operatorname{Alg}\to A$ lifts $J$-limits even when $T$ does not preserve them.}
}

@misc{seerproaldkoudenburg,
  title        = {{Seerp Roald Koudenburg}},
  key          = {Seerp Roald Koudenburg},
  url          = {http://xabier.garcia.martinez.webs.uvigo.gal/CT2024/files/Slides/Koudenburg_Slides.pdf},
  howpublished = {\url{http://xabier.garcia.martinez.webs.uvigo.gal/CT2024/files/Slides/Koudenburg_Slides.pdf}},
  keywords     = {math.CT, mathematics, category-theory, monoidal-categories, algebraic-topology, topos-theory},
  abstract     = {Seerp Roald Koudenburg, formal Day convolution lifts Yoneda morphisms and yields a monoidal double Grothendieck correspondence. Key computation: a lax $T$-algebra $(A,\alpha)$ and Yoneda morphism $y:A\to\widehat A$ lift, when the pointwise weak composite $\alpha_*\odot Ty_*$ exists, to a lax $T$-algebra structure on $\widehat A$ for which $y$ is pseudo-$T$, giving $\widehat A(y,-):(\operatorname{Lax}\text{-}T\text{-}\operatorname{Mor}(B,\widehat A))\simeq(T\text{-}\operatorname{Mor}(A,B))$; for $y:A\to\operatorname{Set}^{A^{\mathrm{op}}}$ this constructs Day convolution, while for $Y:1\to\operatorname{Span}(\operatorname{Cat})$ it identifies lax monoidal lax double functors $G:(B,\otimes)\to(\operatorname{Span}(\operatorname{Cat}),\times)$ with lax monoidal double split opfibrations $\int G\to B$.}
}

@misc{foscoloregian,
  title        = {{Fosco Loregian}},
