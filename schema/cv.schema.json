{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CV",
  "type": "object",
  "required": ["name", "title", "affiliation", "bio", "education"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "title": { "type": "string" },
    "affiliation": { "type": "string" },
    "email": { "type": "string" },
    "bio": { "type": "string" },
    "pinned": {
      "type": "string",
      "description": "Corpus Record id of the item shown in the homepage's Pinned card.",
      "pattern": "^(?:note|blog|visualization|podcast|video|paper|resource):[A-Za-z0-9._-]+$"
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["degree", "institution", "year"],
        "additionalProperties": false,
        "properties": {
          "degree": { "type": "string" },
          "institution": { "type": "string" },
          "year": { "type": "string" }
        }
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "year"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "year": { "type": "string" }
        }
      }
    }
  }
}
