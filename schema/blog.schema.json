{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blog post frontmatter",
  "type": "object",
  "required": ["title", "date", "summary", "category", "tags"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "date": {
      "type": "string",
      "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "summary": { "type": "string" },
    "category": { "type": "string", "minLength": 1 },
    "tags": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "description": "Typed links to other Corpus Records; the build adds the reverse link to each target.",
      "items": {
        "type": "object",
        "required": ["rel", "target"],
        "additionalProperties": false,
        "properties": {
          "rel": { "enum": ["resolves", "extends", "uses", "related"] },
          "target": { "type": "string", "pattern": "^(?:note|blog|visualization|podcast|video|paper|resource):[A-Za-z0-9._-]+$" }
        }
      }
    }
  }
}
