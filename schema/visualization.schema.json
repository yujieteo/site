{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Visualization",
  "type": "object",
  "required": ["slug", "title", "summary", "source_url", "fetched", "html_path", "data_path", "webmcp_tools", "tags", "category"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "minLength": 1 },
    "fetched": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "html_path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+\\.html$" },
    "data_path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+\\.(?:csv|json)$" },
    "webmcp_tools": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "category": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "description": "Further files of a visualization built in this repository, published beside its index.html at their path under visuals/<slug>/.",
      "items": { "type": "string", "pattern": "^visuals/[a-z0-9-]+/(?!.*\\.\\.).+$" },
      "uniqueItems": true
    },
    "downloads": {
      "type": "string",
      "description": "A JSON file in this repository whose downloads list (path, https url, sha256, bytes) the build fetches, checks and publishes under site/visuals/<slug>/. For files too large for Git, such as model weights.",
      "pattern": "^visuals/[a-z0-9-]+/(?!.*\\.\\.).+\\.json$"
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "description": "Typed links to other Corpus Records; the build adds the reverse link to each target.",
      "items": {
        "type": "object",
        "required": ["rel", "target"],
        "additionalProperties": false,
        "properties": {
          "rel": { "enum": ["resolves", "extends", "uses", "related"] },
          "target": { "type": "string", "pattern": "^(?:note|blog|visualization|podcast|video|paper|resource):[A-Za-z0-9._-]+$" }
        }
      }
    }
  }
}
