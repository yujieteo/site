{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Podcast Episode",
  "type": "object",
  "required": ["id", "date", "title", "summary", "focus_tags", "notes", "duration_seconds", "voice", "audio"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "focus_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^note:[a-f0-9]{64}$" }
    },
    "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "voice": { "type": "string", "minLength": 1 },
    "audio": { "type": "string", "pattern": "^audio/[a-z0-9][a-z0-9-]*\\.mp3$" }
  }
}
