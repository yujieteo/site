{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Media Item",
  "type": "object",
  "required": ["id", "date", "title", "summary", "focus_tags", "duration_seconds"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "focus_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" }
    },
    "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "voice": { "type": "string", "minLength": 1 },
    "notes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^note:[a-f0-9]{64}$" }
    },
    "audio": { "type": "string", "pattern": "^audio/[a-z0-9][a-z0-9-]*\\.mp3$" },
    "video": { "type": "string", "pattern": "^video/[a-z0-9][a-z0-9-]*\\.mp4$" },
    "captions": { "type": "string", "pattern": "^video/[a-z0-9][a-z0-9-]*\\.vtt$" },
    "poster": { "type": "string", "pattern": "^video/[a-z0-9][a-z0-9-]*\\.(jpg|jpeg|png)$" },
    "links": {
      "type": "array",
      "minItems": 1,
      "description": "Typed links to other Corpus Records; the build adds the reverse link to each target.",
      "items": {
        "type": "object",
        "required": ["rel", "target"],
        "additionalProperties": false,
        "properties": {
          "rel": { "enum": ["resolves", "extends", "uses", "related"] },
          "target": { "type": "string", "pattern": "^(?:note|blog|visualization|podcast|video|paper|resource):[A-Za-z0-9._-]+$" }
        }
      }
    }
  },
  "oneOf": [
    { "required": ["voice", "notes", "audio"] },
    { "required": ["video", "captions", "poster"] }
  ]
}
