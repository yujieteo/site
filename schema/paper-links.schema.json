{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paper Link",
  "type": "object",
  "required": ["title", "url", "category", "note"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "note": { "type": "string" }
  }
}
